{
  "app": {
    "threads_num": 8,
    "enable_session": true,
    "session_timeout": 3600,
    "document_root": "./web-app/build",
    "upload_path": "./uploads",
    "max_connections": 100000,
    "max_connections_per_ip": 0,
    "load_config_file": false,
    "run_as_daemon": false,
    "relaunch_on_error": false,
    "use_sendfile": true,
    "use_gzip": true,
    "gzip_static": true,
    "static_files_cache_time": 0,
    "idle_connection_timeout": 60,
    "server_header_field": "Object-Storage-Console",
    "keepalive_requests": 0,
    "pipelining_requests": 0,
    "log": {
      "log_path": "./logs",
      "logfile_base_name": "console",
      "log_size_limit": 10485760,
      "log_level": "INFO"
    }
  },
  "listeners": [
    {
      "address": "0.0.0.0",
      "port": 9090,
      "https": false
    }
  ],
  "db_clients": [],
  "plugins": [],
  "custom_config": {}
}
