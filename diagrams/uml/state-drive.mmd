---
title: "State Diagram: Жизненный цикл диска (Drive) в Object Storage"
config:
  theme: default
---
stateDiagram-v2
    %% ==================== INITIAL STATE ====================
    [*] --> Discovered: 🔍 Диск обнаружен в системе

    %% ==================== DISCOVERED STATE ====================
    state Discovered {
        [*] --> Scanning
        Scanning --> Identified: ✅ Информация получена
        Identified --> [*]

        note right of Scanning
            📊 Сбор информации:
            • Model, Serial
            • Capacity
            • Health status (SMART)
        end note
    }

    Discovered --> Offline: ➕ Добавлен в конфигурацию

    %% ==================== OFFLINE STATE ====================
    state Offline {
        [*] --> Configured
        Configured --> ReadyToActivate: ✅ Конфигурация завершена
        ReadyToActivate --> [*]

        note right of Configured
            ⚙️ Диск добавлен, но не активен
            Данные не пишутся
            Ожидает активации
        end note
    }

    Offline --> Online: ⚡ Активация диска

    %% ==================== ONLINE STATE ====================
    state Online {
        [*] --> Healthy

        state Healthy {
            [*] --> Idle
            Idle --> Reading: 📖 Read I/O
            Idle --> Writing: ✏️ Write I/O
            Reading --> Idle: ✅ I/O завершен
            Writing --> Idle: ✅ I/O завершен
        }

        Healthy --> Degraded: ⚠️ Обнаружены предупреждения

        state Degraded {
            [*] --> HighLatency: ⏱️ Высокая задержка
            [*] --> SmartWarning: ⚠️ SMART предупреждение
            [*] --> HighIOPS: 📈 Высокая нагрузка I/O

            HighLatency --> [*]: 📉 Нормализовалась
            SmartWarning --> [*]: ✅ Ложное срабатывание
            HighIOPS --> [*]: 📉 Нагрузка снизилась
        }

        Degraded --> Healthy: ✅ Проблема решена
        Degraded --> Faulty: ❌ Критическая ошибка

        note right of Healthy
            💚 Рабочее состояние
            Участвует в I/O операциях
            Данные доступны
        end note
    }

    Online --> Offline: ⏸️ Деактивация
    Online --> Faulty: ❌ Критическая ошибка

    %% ==================== FAULTY STATE ====================
    state Faulty {
        [*] --> ErrorDetected

        state ErrorDetected {
            [*] --> IOError: 💥 Ошибка I/O
            [*] --> CorruptionDetected: 🔥 Обнаружено повреждение
            [*] --> DriveUnresponsive: 💀 Диск не отвечает
            [*] --> SmartFailure: ⚠️ SMART Failure
        }

        ErrorDetected --> DiagnosticsRunning: 🔍 Запуск диагностики
        DiagnosticsRunning --> RecoverableError: ✅ Ошибка восстановима
        DiagnosticsRunning --> UnrecoverableError: ❌ Ошибка критическая

        RecoverableError --> [*]
        UnrecoverableError --> [*]

        note right of ErrorDetected
            🚨 Критическое состояние
            Требуется вмешательство
            Данные могут быть недоступны
        end note
    }

    Faulty --> Healing: 🔧 Запуск восстановления

    %% ==================== HEALING STATE ====================
    state Healing {
        [*] --> ScanningData
        ScanningData --> IdentifyingCorruption: 📊 Сканирование завершено
        IdentifyingCorruption --> RebuildingData: 🔍 Найдены поврежденные данные

        state RebuildingData {
            [*] --> ReadingParity: 📖 Чтение parity
            ReadingParity --> ReconstructingBlocks: 🔨 Восстановление блоков
            ReconstructingBlocks --> WritingRebuilt: ✏️ Запись восстановленных
            WritingRebuilt --> VerifyingIntegrity: ✅ Проверка целостности
            VerifyingIntegrity --> [*]
        }

        RebuildingData --> HealingComplete: ✅ Данные восстановлены
        RebuildingData --> HealingFailed: ❌ Ошибка восстановления

        HealingComplete --> [*]
        HealingFailed --> [*]

        note right of RebuildingData
            🔄 Erasure Coding
            Использование избыточности
            для восстановления данных
            с других дисков
        end note
    }

    Healing --> Online: ✅ Восстановление успешно
    Healing --> Faulty: ❌ Ошибка восстановления

    %% ==================== MAINTENANCE STATE ====================
    Faulty --> Maintenance: 🔧 Требуется обслуживание
    Online --> Maintenance: 📅 Плановое обслуживание

    state Maintenance {
        [*] --> ScheduledMaintenance: 📅 Плановое
        [*] --> EmergencyMaintenance: 🚨 Аварийное

        ScheduledMaintenance --> DataMigrating: 📦 Миграция данных
        EmergencyMaintenance --> DataMigrating: 📦 Срочная миграция

        DataMigrating --> DataMigrated: ✅ Данные перемещены
        DataMigrated --> SafeToRemove: 🔓 Безопасно для извлечения

        SafeToRemove --> [*]

        note right of DataMigrating
            📦 Безопасная миграция
            Данные переносятся на
            другие диски в пуле
        end note
    }

    Maintenance --> Online: ✅ Обслуживание завершено
    Maintenance --> Decommissioning: 🔄 Вывод из эксплуатации

    %% ==================== DECOMMISSIONING STATE ====================
    state Decommissioning {
        [*] --> DrainStarted: 📤 Начат drain
        DrainStarted --> DataRebalancing: 📊 Перебалансировка

        state DataRebalancing {
            [*] --> MovingObjects: 📦 Перемещение объектов
            MovingObjects --> UpdatingMetadata: 📋 Обновление метаданных
            UpdatingMetadata --> VerifyingMoves: ✅ Верификация
            VerifyingMoves --> [*]
        }

        DataRebalancing --> DrainComplete: ✅ Все данные перемещены
        DrainComplete --> RemovedFromPool: 🔓 Удален из пула
        RemovedFromPool --> [*]
    }

    Decommissioning --> Decommissioned: ✅ Вывод завершен

    %% ==================== DECOMMISSIONED STATE ====================
    state Decommissioned {
        [*] --> Retired: 🔴 Выведен из эксплуатации
        Retired --> PhysicallyRemoved: 🔧 Физически извлечен
        PhysicallyRemoved --> [*]

        note right of Retired
            🔴 Диск выведен
            Можно безопасно
            извлечь из системы
        end note
    }

    Decommissioned --> [*]: 💀 Диск удален из системы
