---
title: "State Diagram: Жизненный цикл объекта в Object Storage"
config:
  theme: default
---
stateDiagram-v2
    %% ==================== INITIAL STATE ====================
    [*] --> Uploading: 📤 Инициация загрузки

    %% ==================== UPLOADING STATE ====================
    state Uploading {
        [*] --> Validating: Начало загрузки
        Validating --> Encrypting: ✅ Валидация пройдена
        Validating --> UploadFailed: ❌ Ошибка валидации
        Encrypting --> Writing: 🔐 Шифрование завершено
        Writing --> CalculatingETag: 💾 Запись на диск
        CalculatingETag --> SavingMetadata: #️⃣ ETag вычислен
        SavingMetadata --> [*]: 📋 Метаданные сохранены
    }

    Uploading --> Active: ✅ Загрузка успешна
    Uploading --> Failed: ❌ Ошибка загрузки

    %% ==================== FAILED STATE ====================
    state Failed {
        [*] --> UploadFailed
        UploadFailed --> TempFileCleanup: 🗑️ Очистка
        TempFileCleanup --> [*]
    }

    Failed --> [*]: Очистка временных файлов

    %% ==================== ACTIVE STATE ====================
    state Active {
        [*] --> Available
        Available --> BeingAccessed: 📖 GET запрос
        BeingAccessed --> Available: Доступ завершен
        Available --> BeingModified: ✏️ Изменение метаданных
        BeingModified --> Available: Метаданные обновлены

        note right of Available
            📦 Основное рабочее состояние
            Доступен для чтения и записи
        end note
    }

    Active --> Versioned: 📚 Новая версия загружена<br/>[versioning enabled]

    %% ==================== VERSIONED STATE ====================
    state Versioned {
        [*] --> CurrentVersion
        CurrentVersion --> PreviousVersion: 📤 Новая версия загружена
        PreviousVersion --> CurrentVersion: ♻️ Восстановление версии
        PreviousVersion --> VersionDeleted: 🗑️ Удаление версии
        VersionDeleted --> [*]

        note right of CurrentVersion
            📚 История версий сохраняется
            Можно восстановить любую версию
        end note
    }

    Versioned --> Active: ♻️ Версия восстановлена

    %% ==================== LOCKED STATE ====================
    Active --> Locked: 🔒 Включена блокировка<br/>[object-lock enabled]

    state Locked {
        [*] --> GovernanceLock
        [*] --> ComplianceLock

        GovernanceLock --> [*]: ⏰ Lock expired
        GovernanceLock --> ComplianceLock: ⬆️ Повышение до Compliance

        ComplianceLock --> [*]: ⏰ Retention period ended

        note right of ComplianceLock
            🛡️ WORM Protection
            Нельзя удалить или изменить
            до истечения срока retention
        end note
    }

    Locked --> Active: 🔓 Блокировка снята

    %% ==================== LEGAL HOLD STATE ====================
    Active --> LegalHold: ⚖️ Установлен Legal Hold

    state LegalHold {
        [*] --> HoldActive
        HoldActive --> [*]: ⚖️ Legal Hold снят

        note right of HoldActive
            ⚖️ Юридическая защита
            Объект защищен от удаления
            независимо от retention
        end note
    }

    LegalHold --> Active: ⚖️ Legal Hold снят

    %% ==================== ARCHIVED STATE ====================
    Active --> Archived: 📦 Lifecycle правило<br/>[transition to archive]

    state Archived {
        [*] --> GlacierClass
        [*] --> DeepArchiveClass

        GlacierClass --> Restoring: 📤 Запрос на восстановление
        DeepArchiveClass --> Restoring: 📤 Запрос на восстановление

        Restoring --> RestoredTemporarily: ✅ Восстановлен
        RestoredTemporarily --> GlacierClass: ⏰ Истек срок восстановления
        RestoredTemporarily --> DeepArchiveClass: ⏰ Истек срок восстановления

        note right of GlacierClass
            ❄️ Холодное хранение
            Низкая стоимость
            Время восстановления: 1-5 часов
        end note

        note right of DeepArchiveClass
            🧊 Глубокий архив
            Минимальная стоимость
            Время восстановления: 12-48 часов
        end note
    }

    Archived --> Active: ⬆️ Перемещение в Standard

    %% ==================== DELETION STATES ====================
    Active --> MarkedForDeletion: 🗑️ DELETE запрос

    state MarkedForDeletion {
        [*] --> SoftDeleted: 🗑️ Мягкое удаление
        SoftDeleted --> DeleteMarker: 📌 Создан delete marker<br/>[versioning enabled]
        SoftDeleted --> PendingPermanentDeletion: ⏳ Без версионирования

        DeleteMarker --> [*]: 📚 Версии сохранены
        PendingPermanentDeletion --> [*]: 🗑️ Объект удален
    }

    MarkedForDeletion --> Active: ♻️ Восстановление из корзины
    MarkedForDeletion --> PermanentlyDeleted: 💀 Постоянное удаление

    state PermanentlyDeleted {
        [*] --> DataWiped: 🔥 Данные удалены
        DataWiped --> MetadataRemoved: 📋 Метаданные очищены
        MetadataRemoved --> [*]
    }

    PermanentlyDeleted --> [*]: 💀 Объект полностью удален
