---
title: "Activity Diagram: Загрузка файла TO-BE (Object Storage Console)"
config:
  theme: default
---
flowchart TD
    %% ==================== LEGEND ====================
    subgraph legend ["📋 Легенда UML Activity"]
        direction LR
        L_Start(( )):::startEnd
        L_End((◉)):::finalEnd
        L_Action["Действие<br/>пользователя"]:::userAction
        L_System[["Автоматическое<br/>действие системы"]]:::systemAction
        L_Decision{"Решение/<br/>Условие"}:::decision
    end

    %% ==================== USER SWIMLANE ====================
    subgraph user_lane ["👤 Пользователь (Браузер)"]
        direction TB
        Start(( )):::startEnd
        Start --> OpenBrowser["🌐 Открыть веб-интерфейс<br/>Object Storage Console"]

        OpenBrowser --> CheckAuth{"Авторизован?"}

        CheckAuth -->|Нет| Login["🔐 Ввести логин и пароль"]
    end

    %% ==================== AUTH SERVICE SWIMLANE ====================
    subgraph auth_lane ["🔒 AuthService"]
        direction TB
        Login --> ValidateAuth[["Валидация<br/>учетных данных"]]

        ValidateAuth --> AuthResult{"Аутентификация<br/>успешна?"}

        AuthResult -->|Нет| ShowAuthError["❌ Показать ошибку<br/>авторизации"]
        ShowAuthError --> Login

        AuthResult -->|Да| GenerateJWT[["Генерация<br/>JWT токена"]]
        GenerateJWT --> StoreToken[["Сохранение токена<br/>в браузере"]]
    end

    %% ==================== USER LANE 2 ====================
    subgraph user_lane2 ["👤 Пользователь (продолжение)"]
        direction TB
        StoreToken --> SelectBucket
        CheckAuth -->|Да| SelectBucket["📁 Выбрать бакет<br/>из списка"]

        SelectBucket --> BucketExists{"Бакет<br/>существует?"}

        BucketExists -->|Нет| CreateBucket["➕ Создать<br/>новый бакет"]
        CreateBucket --> BucketExists

        BucketExists -->|Да| CheckBucketAccess
    end

    %% ==================== POLICY SERVICE SWIMLANE ====================
    subgraph policy_lane ["🛡️ PolicyEvaluator"]
        direction TB
        CheckBucketAccess[["Проверка прав<br/>доступа IAM"]]

        CheckBucketAccess --> HasAccess{"Есть права<br/>на запись?"}

        HasAccess -->|Нет| AccessDenied["🚫 Показать ошибку<br/>403: Доступ запрещен"]
        AccessDenied --> SelectBucket2["📁 Выбрать<br/>другой бакет"]
        SelectBucket2 --> CheckBucketAccess
    end

    %% ==================== USER LANE 3 ====================
    subgraph user_lane3 ["👤 Пользователь (загрузка)"]
        direction TB
        HasAccess -->|Да| DragDrop["📤 Drag and Drop файла<br/>или выбор через диалог"]
    end

    %% ==================== OBJECT SERVICE SWIMLANE ====================
    subgraph object_lane ["📦 ObjectService"]
        direction TB
        DragDrop --> ValidateFile[["Валидация файла:<br/>размер, тип, имя"]]

        ValidateFile --> FileValid{"Файл<br/>валиден?"}

        FileValid -->|Нет| ShowValidationError["❌ Показать ошибку<br/>валидации"]
        ShowValidationError --> DragDrop

        FileValid -->|Да| CheckEncryption[["Проверка настроек<br/>шифрования бакета"]]
    end

    %% ==================== ENCRYPTION SERVICE SWIMLANE ====================
    subgraph encrypt_lane ["🔐 EncryptionService"]
        direction TB
        CheckEncryption --> EncryptionEnabled{"Шифрование<br/>включено?"}

        EncryptionEnabled -->|Да| EncryptData[["🔒 Шифрование<br/>AES-256-GCM"]]
        EncryptData --> StartUpload

        EncryptionEnabled -->|Нет| StartUpload[["Начало<br/>multipart upload"]]
    end

    %% ==================== STORAGE SWIMLANE ====================
    subgraph storage_lane ["💾 LocalStorageClient"]
        direction TB
        StartUpload --> UploadProgress["📊 Отображение<br/>прогресс-бара"]

        UploadProgress --> CalcEtag[["Вычисление ETag<br/>(MD5 хеш)"]]

        CalcEtag --> SaveObject[["Атомарная запись<br/>на диск"]]

        SaveObject --> SaveMetadata[["Сохранение<br/>метаданных (.meta)"]]

        SaveMetadata --> CheckVersioning{"Версионирование<br/>включено?"}

        CheckVersioning -->|Да| CreateVersion[["📚 Создание новой<br/>версии объекта"]]
        CreateVersion --> LogActivity

        CheckVersioning -->|Нет| LogActivity[["📝 Логирование<br/>операции"]]
    end

    %% ==================== FINAL USER ACTIONS ====================
    subgraph user_final ["👤 Пользователь (завершение)"]
        direction TB
        LogActivity --> UpdateUI["🔄 Обновление UI:<br/>Файл в списке"]

        UpdateUI --> ShowSuccess["✅ Показать уведомление<br/>об успехе"]

        ShowSuccess --> NeedShare{"Поделиться<br/>файлом?"}

        NeedShare -->|Да| GeneratePresigned[["🔗 Генерация<br/>Presigned URL"]]
        GeneratePresigned --> CopyLink["📋 Скопировать ссылку<br/>в буфер"]
        CopyLink --> EndSuccess((◉)):::successEnd

        NeedShare -->|Нет| EndSuccess
    end

    %% ==================== STYLING ====================
    classDef startEnd fill:#000000,stroke:#000000,color:#000000
    classDef successEnd fill:#4CAF50,stroke:#2E7D32,color:#ffffff
    classDef userAction fill:#E3F2FD,stroke:#1976D2,stroke-width:1px
    classDef systemAction fill:#E8F5E9,stroke:#388E3C,stroke-width:2px
    classDef decision fill:#FFFFFF,stroke:#424242,stroke-width:1px
    classDef errorAction fill:#FFEBEE,stroke:#C62828

    class Start startEnd
    class EndSuccess successEnd
    class OpenBrowser,Login,SelectBucket,CreateBucket,DragDrop,UploadProgress,UpdateUI,ShowSuccess,CopyLink,SelectBucket2 userAction
    class ValidateAuth,GenerateJWT,StoreToken,CheckBucketAccess,ValidateFile,CheckEncryption,EncryptData,StartUpload,CalcEtag,SaveObject,SaveMetadata,CreateVersion,LogActivity,GeneratePresigned systemAction
    class AccessDenied,ShowAuthError,ShowValidationError errorAction
