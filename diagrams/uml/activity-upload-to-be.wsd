@startuml activity-upload-to-be
title Activity Diagram: Загрузка файла TO-BE (Object Storage Console)

skinparam activity {
    BackgroundColor White
    BorderColor Black
    ArrowColor Gray
}

|#E3F2FD|Пользователь|
start

:Открыть веб-интерфейс
Object Storage Console;

if (Авторизован?) then (Нет)
    :Ввести логин и пароль;

    |#E8F5E9|AuthService|
    :Валидация учетных данных;

    if (Аутентификация успешна?) then (Нет)
        #FFEBEE:Показать ошибку авторизации;
        |#E3F2FD|Пользователь|
        detach
    else (Да)
        :Генерация JWT токена;
        :Сохранение токена в браузере;
    endif
    |#E3F2FD|Пользователь|
else (Да)
endif

:Выбрать бакет из списка;

if (Бакет существует?) then (Нет)
    :Создать новый бакет;
else (Да)
endif

|#FFF3E0|PolicyEvaluator|
:Проверка прав доступа IAM;

if (Есть права на запись?) then (Нет)
    #FFEBEE:Показать ошибку
    403: Доступ запрещен;
    |#E3F2FD|Пользователь|
    detach
else (Да)
endif

|#E3F2FD|Пользователь|
:Drag and Drop файла
или выбор через диалог;

|#E8F5E9|ObjectService|
:Валидация файла:
размер, тип, имя;

if (Файл валиден?) then (Нет)
    #FFEBEE:Показать ошибку валидации;
    |#E3F2FD|Пользователь|
    detach
else (Да)
endif

:Проверка настроек шифрования бакета;

|#FCE4EC|EncryptionService|
if (Шифрование включено?) then (Да)
    :Шифрование AES-256-GCM;
    note right
        Автоматическое
        шифрование данных
    end note
else (Нет)
endif

|#E8F5E9|LocalStorageClient|
:Начало multipart upload;

|#E3F2FD|Пользователь|
:Отображение прогресс-бара;

|#E8F5E9|LocalStorageClient|
:Вычисление ETag (MD5 хеш);

:Атомарная запись на диск;
note right
    Безопасная запись
    с использованием
    временных файлов
end note

|#FFF9C4|MetadataManager|
:Сохранение метаданных (.meta);

if (Версионирование включено?) then (Да)
    :Создание новой версии объекта;
else (Нет)
endif

|#E0E0E0|StatsCollector|
:Логирование операции;

|#E3F2FD|Пользователь|
:Обновление UI: Файл в списке;

:Показать уведомление об успехе;

if (Поделиться файлом?) then (Да)
    |#EDE7F6|ObjectService|
    :Генерация Presigned URL;
    |#E3F2FD|Пользователь|
    :Скопировать ссылку в буфер;
else (Нет)
endif

#90EE90:Файл успешно загружен;
stop

@enduml
