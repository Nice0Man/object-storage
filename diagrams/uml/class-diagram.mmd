---
title: "Class Diagram: Object Storage Console - Сервисы и модели"
config:
  theme: default
---
classDiagram
    direction TB

    %% ==================== INTERFACES ====================
    class IAuthService {
        <<interface>>
        +login(username: String, password: String) Result~LoginResponse~
        +logout(token: String) Result~void~
        +validateToken(token: String) Result~UserInfo~
        +refreshToken(token: String) Result~LoginResponse~
        +changePassword(userInfo: UserInfo, oldPwd: String, newPwd: String) Result~void~
    }

    class IBucketService {
        <<interface>>
        +list_buckets(userInfo: UserInfo) Result~Vector~Bucket~~
        +create_bucket(userInfo: UserInfo, name: String, region: String, objectLocking: bool) Result~Bucket~
        +delete_bucket(userInfo: UserInfo, name: String) Result~void~
        +get_bucket_info(userInfo: UserInfo, name: String) Result~Bucket~
        +set_bucket_policy(userInfo: UserInfo, name: String, policy: String) Result~void~
        +get_bucket_policy(userInfo: UserInfo, name: String) Result~String~
        +set_bucket_versioning(userInfo: UserInfo, name: String, enabled: bool) Result~void~
        +get_bucket_versioning(userInfo: UserInfo, name: String) Result~bool~
        +set_bucket_tags(userInfo: UserInfo, name: String, tags: StringMap) Result~void~
        +get_bucket_tags(userInfo: UserInfo, name: String) Result~StringMap~
        +set_bucket_encryption(userInfo: UserInfo, name: String, config: Json) Result~void~
        +set_bucket_lifecycle(userInfo: UserInfo, name: String, rules: Json) Result~void~
    }

    class IObjectService {
        <<interface>>
        +list_objects(userInfo: UserInfo, bucket: String, prefix: String, recursive: bool, maxKeys: int) Result~Vector~Object~~
        +get_object_info(userInfo: UserInfo, bucket: String, key: String) Result~Object~
        +upload_object(userInfo: UserInfo, bucket: String, key: String, data: ByteArray, contentType: String, metadata: StringMap) Result~Object~
        +download_object(userInfo: UserInfo, bucket: String, key: String) Result~ByteArray~
        +delete_object(userInfo: UserInfo, bucket: String, key: String) Result~void~
        +delete_objects(userInfo: UserInfo, bucket: String, keys: Vector~String~) Result~Json~
        +copy_object(userInfo: UserInfo, srcBucket: String, srcKey: String, dstBucket: String, dstKey: String) Result~Object~
        +set_object_tags(userInfo: UserInfo, bucket: String, key: String, tags: StringMap) Result~void~
        +get_object_tags(userInfo: UserInfo, bucket: String, key: String) Result~StringMap~
        +generate_presigned_url(userInfo: UserInfo, bucket: String, key: String, method: String, expiry: int) Result~String~
    }

    class IUserService {
        <<interface>>
        +list_users(userInfo: UserInfo) Result~Vector~User~~
        +get_user(userInfo: UserInfo, accessKey: String) Result~User~
        +create_user(userInfo: UserInfo, username: String, password: String, isAdmin: bool) Result~User~
        +update_user(userInfo: UserInfo, accessKey: String, updates: Json) Result~void~
        +delete_user(userInfo: UserInfo, accessKey: String) Result~void~
        +assign_policy(userInfo: UserInfo, accessKey: String, policyName: String, policy: String) Result~void~
        +remove_policy(userInfo: UserInfo, accessKey: String, policyName: String) Result~void~
    }

    class IInfrastructureService {
        <<interface>>
        +get_summary(userInfo: UserInfo) Result~InfrastructureSummary~
        +list_servers(userInfo: UserInfo) Result~Vector~Server~~
        +list_drives(userInfo: UserInfo) Result~Vector~Drive~~
        +list_pools(userInfo: UserInfo) Result~Vector~Pool~~
        +get_heal_status(userInfo: UserInfo) Result~HealStatus~
        +start_heal(userInfo: UserInfo) Result~void~
    }

    class IStorageClient {
        <<interface>>
        +put_object(bucket: String, key: String, data: ByteArray, metadata: StringMap) Result~Object~
        +get_object(bucket: String, key: String) Result~ByteArray~
        +delete_object(bucket: String, key: String) Result~void~
        +list_objects(bucket: String, prefix: String, recursive: bool, maxKeys: int) Result~Vector~Object~~
        +stat_object(bucket: String, key: String) Result~Object~
        +copy_object(src: ObjectId, dst: ObjectId) Result~Object~
        +create_bucket(name: String, region: String) Result~bool~
        +delete_bucket(name: String) Result~void~
        +list_buckets() Result~Vector~Bucket~~
        +bucket_exists(name: String) Result~bool~
    }

    %% ==================== IMPLEMENTATIONS ====================
    class AuthService {
        -jwt_secret: String
        -token_expiry: int
        -db_manager: DatabaseManager*
        +login(username: String, password: String) Result~LoginResponse~
        +validateToken(token: String) Result~UserInfo~
        -generateJWT(user: User) String
        -hashPassword(password: String) String
        -verifyPassword(password: String, hash: String) bool
    }

    class BucketService {
        -storage_client: IStorageClient*
        -db_manager: DatabaseManager*
        -policy_evaluator: PolicyEvaluator*
        +list_buckets(userInfo: UserInfo) Result~Vector~Bucket~~
        +create_bucket(userInfo: UserInfo, name: String, region: String, objectLocking: bool) Result~Bucket~
        -validateBucketName(name: String) bool
    }

    class ObjectService {
        -storage_client: IStorageClient*
        -policy_evaluator: PolicyEvaluator*
        -encryption_service: EncryptionService*
        -stats_collector: StatsCollector*
        +upload_object(userInfo: UserInfo, bucket: String, key: String, data: ByteArray, contentType: String, metadata: StringMap) Result~Object~
        +download_object(userInfo: UserInfo, bucket: String, key: String) Result~ByteArray~
        -calculateETag(data: ByteArray) String
        -generatePresignedSignature(bucket: String, key: String, expiry: int) String
    }

    class UserService {
        -db_manager: DatabaseManager*
        -policy_evaluator: PolicyEvaluator*
        +list_users(userInfo: UserInfo) Result~Vector~User~~
        +create_user(userInfo: UserInfo, username: String, password: String, isAdmin: bool) Result~User~
        -generateAccessKey() String
        -generateSecretKey() String
    }

    class InfrastructureService {
        -storage_client: IStorageClient*
        -stats_collector: StatsCollector*
        +get_summary(userInfo: UserInfo) Result~InfrastructureSummary~
        +list_servers(userInfo: UserInfo) Result~Vector~Server~~
    }

    class LocalStorageClient {
        -root_path: String
        -metadata_manager: MetadataManager*
        -path_manager: PathManager*
        +put_object(bucket: String, key: String, data: ByteArray, metadata: StringMap) Result~Object~
        +get_object(bucket: String, key: String) Result~ByteArray~
        -atomicWrite(path: String, data: ByteArray) bool
        -ensureDirectory(path: String) void
    }

    %% ==================== SUPPORT CLASSES ====================
    class PolicyEvaluator {
        -db_manager: DatabaseManager*
        +evaluateAccess(userInfo: UserInfo, resource: String, action: String) AccessResult
        +loadBucketPolicy(bucket: String) Policy
        +loadUserPolicies(userId: String) Vector~Policy~
        -matchResource(pattern: String, resource: String) bool
        -evaluateConditions(conditions: Json, context: Context) bool
    }

    class EncryptionService {
        -encryption_key: ByteArray
        -algorithm: String
        +encrypt(data: ByteArray, algorithm: String) EncryptedData
        +decrypt(encryptedData: EncryptedData) ByteArray
        -generateIV() ByteArray
        -deriveKey(passphrase: String, salt: ByteArray) ByteArray
    }

    class StatsCollector {
        -db_manager: DatabaseManager*
        +logActivity(action: String, bucket: String, key: String, userId: String) void
        +getSystemStats() SystemStats
        +getCapacityStats() CapacityStats
        +getActivityStats() ActivityStats
    }

    class DatabaseManager {
        -db_path: String
        -connection: sqlite3*
        +initialize() void
        +execute(query: String, params: Vector~Variant~) Result~void~
        +query(sql: String, params: Vector~Variant~) Result~Vector~Row~~
        +beginTransaction() void
        +commit() void
        +rollback() void
    }

    class MetadataManager {
        -db_manager: DatabaseManager*
        +loadObjectMetadata(bucket: String, key: String) ObjectMetadata
        +saveObjectMetadata(metadata: ObjectMetadata) void
        +loadBucketMetadata(bucket: String) BucketMetadata
        +saveBucketMetadata(metadata: BucketMetadata) void
    }

    class PathManager {
        -storage_root: String
        +getBucketPath(bucket: String) String
        +getObjectPath(bucket: String, key: String) String
        +getMetadataPath(bucket: String, key: String) String
        +getVersionPath(bucket: String, key: String, versionId: String) String
        +ensureDirectoryExists(path: String) void
    }

    %% ==================== MODELS ====================
    class Bucket {
        <<entity>>
        -name: String
        -creation_date: TimePoint
        -region: String
        -versioning: bool
        -encryption: bool
        -object_lock: bool
        -size: int64
        -objects_count: int
        +to_json() Json
        +from_json(json: Json)$ Bucket
    }

    class Object {
        <<entity>>
        -key: String
        -bucket: String
        -size: int64
        -etag: String
        -content_type: String
        -last_modified: TimePoint
        -metadata: StringMap
        -user_metadata: StringMap
        -encrypted: bool
        -encryption_algorithm: String
        +to_json() Json
        +from_json(json: Json)$ Object
        +is_directory() bool
        +extension() String
    }

    class User {
        <<entity>>
        -username: String
        -access_key: String
        -secret_key: String
        -is_admin: bool
        -status: UserStatus
        -policies: Vector~String~
        -groups: Vector~String~
        -created_at: TimePoint
        +to_json() Json
        +from_json(json: Json)$ User
    }

    class Policy {
        <<entity>>
        -name: String
        -version: String
        -statements: Vector~Statement~
        +to_json() Json
        +from_json(json: Json)$ Policy
        +evaluate(action: String, resource: String, context: Context) AccessResult
    }

    class Server {
        <<entity>>
        -id: String
        -hostname: String
        -endpoint: String
        -status: ServerStatus
        -drives_count: int
        -uptime: int64
        +to_json() Json
    }

    class Drive {
        <<entity>>
        -id: String
        -server_id: String
        -path: String
        -status: DriveStatus
        -total_space: int64
        -used_space: int64
        -model: String
        -serial: String
        +to_json() Json
    }

    class Pool {
        <<entity>>
        -id: String
        -name: String
        -status: PoolStatus
        -servers: Vector~String~
        -erasure_set_size: int
        -parity_drives: int
        -total_capacity: int64
        -used_capacity: int64
        +to_json() Json
    }

    %% ==================== RELATIONSHIPS ====================

    %% Interface Realizations (Implementation)
    IAuthService <|.. AuthService : реализует
    IBucketService <|.. BucketService : реализует
    IObjectService <|.. ObjectService : реализует
    IUserService <|.. UserService : реализует
    IInfrastructureService <|.. InfrastructureService : реализует
    IStorageClient <|.. LocalStorageClient : реализует

    %% Dependencies (uses)
    AuthService ..> DatabaseManager : ≪use≫
    BucketService ..> IStorageClient : ≪use≫
    BucketService ..> DatabaseManager : ≪use≫
    BucketService ..> PolicyEvaluator : ≪use≫
    ObjectService ..> IStorageClient : ≪use≫
    ObjectService ..> PolicyEvaluator : ≪use≫
    ObjectService ..> EncryptionService : ≪use≫
    ObjectService ..> StatsCollector : ≪use≫
    UserService ..> DatabaseManager : ≪use≫
    UserService ..> PolicyEvaluator : ≪use≫
    InfrastructureService ..> IStorageClient : ≪use≫
    InfrastructureService ..> StatsCollector : ≪use≫

    %% Storage client dependencies
    LocalStorageClient ..> MetadataManager : ≪use≫
    LocalStorageClient ..> PathManager : ≪use≫
    MetadataManager ..> DatabaseManager : ≪use≫

    %% Support class dependencies
    PolicyEvaluator ..> DatabaseManager : ≪use≫
    StatsCollector ..> DatabaseManager : ≪use≫

    %% Dependencies - creation/management
    ObjectService ..> Object : ≪create≫
    BucketService ..> Bucket : ≪create≫
    UserService ..> User : ≪create≫
    PolicyEvaluator ..> Policy : ≪use≫
    InfrastructureService ..> Server : ≪use≫
    InfrastructureService ..> Drive : ≪use≫
    InfrastructureService ..> Pool : ≪use≫

    %% Aggregations (part-of, can exist independently)
    Bucket "1" o-- "0..*" Object : содержит
    Server "1" o-- "1..*" Drive : включает
    Pool "1" o-- "1..*" Server : объединяет
    User "1" o-- "0..*" Policy : имеет
