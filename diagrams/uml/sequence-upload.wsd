@startuml sequence-upload
title Sequence Diagram: Загрузка объекта в Object Storage

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "Пользователь" as User
participant "Браузер\nReact SPA" as Browser
participant "ObjectsController\nREST API" as API
participant "AuthMiddleware\nJWT Validation" as AuthMW
participant "AuthService" as AuthSvc
participant "ObjectService" as ObjSvc
participant "PolicyEvaluator" as PolicyEval
participant "EncryptionService" as EncSvc
participant "LocalStorageClient" as Storage
participant "MetadataManager" as MetaMgr
database "SQLite Database" as DB
collections "Файловая система" as FS

note over User, FS: Процесс загрузки объекта с шифрованием и версионированием

== Шаг 1: Инициация загрузки ==

User -> Browser: Drag & Drop файла
activate Browser
Browser -> API: POST /api/v1/buckets/{bucket}/objects\nContent-Type: multipart/form-data\nAuthorization: Bearer JWT
activate API

== Шаг 2: Валидация JWT токена ==

API -> AuthMW: validateRequest(request)
activate AuthMW
AuthMW -> AuthSvc: verifyToken(jwt)
activate AuthSvc
AuthSvc -> AuthSvc: decodeJWT(token)
AuthSvc -> AuthSvc: validateExpiration()
AuthSvc -> AuthSvc: validateSignature(secret)

alt JWT невалидный
    AuthSvc --> AuthMW: Error: Invalid token
    AuthMW --> API: 401 Unauthorized
    API --> Browser: {"error": "Invalid or expired token"}
    Browser --> User: Показать ошибку авторизации
else JWT валидный
    AuthSvc --> AuthMW: UserInfo{userId, roles, permissions}
    deactivate AuthSvc
    AuthMW --> API: UserInfo
    deactivate AuthMW
end

== Шаг 3: Проверка прав доступа ==

API -> ObjSvc: upload_object(userInfo, bucket, key, data)
activate ObjSvc
ObjSvc -> PolicyEval: evaluateAccess(userInfo, bucket, "s3:PutObject")
activate PolicyEval
PolicyEval -> PolicyEval: loadBucketPolicy(bucket)
PolicyEval -> PolicyEval: loadUserPolicies(userId)
PolicyEval -> PolicyEval: evaluateStatements()

alt Доступ запрещен
    PolicyEval --> ObjSvc: AccessDenied
    ObjSvc --> API: Error 403
    API --> Browser: {"error": "Access denied", "code": 403}
    Browser --> User: Показать ошибку доступа
else Доступ разрешен
    PolicyEval --> ObjSvc: AccessGranted
    deactivate PolicyEval
end

== Шаг 4: Проверка настроек бакета ==

ObjSvc -> Storage: getBucketInfo(bucket)
activate Storage
Storage -> MetaMgr: loadBucketMetadata(bucket)
activate MetaMgr
MetaMgr -> DB: SELECT * FROM buckets WHERE name = ?
activate DB
DB --> MetaMgr: BucketRow
deactivate DB
MetaMgr --> Storage: BucketMetadata{versioning, encryption}
deactivate MetaMgr
Storage --> ObjSvc: BucketInfo
deactivate Storage

== Шаг 5: Шифрование (опционально) ==

alt Шифрование включено
    ObjSvc -> EncSvc: encrypt(data, "AES-256-GCM", key)
    activate EncSvc
    EncSvc -> EncSvc: generateIV()
    EncSvc -> EncSvc: encryptAES256(data, key, iv)
    EncSvc --> ObjSvc: EncryptedData{ciphertext, iv, algorithm}
    deactivate EncSvc
    note right of EncSvc: AES-256-GCM
end

== Шаг 6: Вычисление ETag ==

ObjSvc -> ObjSvc: calculateETag(data) = MD5 hash

== Шаг 7: Сохранение объекта ==

ObjSvc -> Storage: put_object(bucket, key, data, metadata)
activate Storage
Storage -> Storage: generateObjectPath(bucket, key)
Storage -> FS: writeTemp(tempPath, data)
activate FS
FS --> Storage: tempFile created
deactivate FS

Storage -> FS: atomicRename(tempPath, objectPath)
activate FS
FS --> Storage: success
deactivate FS

== Шаг 8: Сохранение метаданных ==

Storage -> MetaMgr: saveObjectMetadata(objectMeta)
activate MetaMgr
MetaMgr -> FS: writeFile(objectPath + ".meta", metaJson)
activate FS
FS --> MetaMgr: success
deactivate FS

MetaMgr -> DB: INSERT INTO objects (bucket, key, size, etag)
activate DB
DB --> MetaMgr: rowId
deactivate DB
MetaMgr --> Storage: success
deactivate MetaMgr

== Шаг 9: Версионирование (опционально) ==

alt Версионирование включено
    Storage -> Storage: generateVersionId()
    Storage -> FS: copyToVersions(objectPath, versionId)
    activate FS
    FS --> Storage: versionCreated
    deactivate FS
    Storage -> DB: INSERT INTO object_versions (...)
    activate DB
    DB --> Storage: versionRowId
    deactivate DB
end

Storage --> ObjSvc: Object{key, etag, size, versionId}
deactivate Storage

== Шаг 10: Логирование ==

ObjSvc -> ObjSvc: logActivity("upload", bucket, key, userId)

ObjSvc --> API: Result<Object>
deactivate ObjSvc

== Шаг 11: Формирование ответа ==

API -> API: formatResponse(object)
API --> Browser: 201 Created\n{"key": "...", "etag": "...", "size": ...}
deactivate API
Browser --> User: Объект успешно загружен
deactivate Browser

note over User, FS: Объект успешно загружен и сохранен

@enduml
