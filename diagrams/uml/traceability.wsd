@startuml traceability
title Traceability Matrix: Требования - Проектирование - Реализация - Тесты

skinparam rectangle {
    BackgroundColor White
    BorderColor Black
}

skinparam package {
    BackgroundColor #F5F5F5
}

' ==================== REQUIREMENTS ====================
package "ФУНКЦИОНАЛЬНЫЕ ТРЕБОВАНИЯ" #E3F2FD {

    package "Аутентификация" {
        rectangle "REQ-001\nЛогин/Пароль" as REQ001
        rectangle "REQ-002\nJWT токены" as REQ002
        rectangle "REQ-003\nIAM права" as REQ003
        rectangle "REQ-004\nРоли Admin/User" as REQ004
    }

    package "Бакеты" {
        rectangle "REQ-005\nCRUD" as REQ005
        rectangle "REQ-006\nВерсионирование" as REQ006
        rectangle "REQ-007\nШифрование" as REQ007
        rectangle "REQ-008\nПолитики" as REQ008
    }

    package "Объекты" {
        rectangle "REQ-010\nЗагрузка" as REQ010
        rectangle "REQ-011\nСкачивание" as REQ011
        rectangle "REQ-012\nУдаление" as REQ012
        rectangle "REQ-014\nPresigned URL" as REQ014
    }

    package "Инфраструктура" {
        rectangle "REQ-016\nМониторинг серверов" as REQ016
        rectangle "REQ-017\nМониторинг дисков" as REQ017
        rectangle "REQ-018\nВосстановление" as REQ018
    }
}

' ==================== DESIGN ====================
package "ПРОЕКТНЫЕ РЕШЕНИЯ" #E8F5E9 {
    rectangle "AuthService" as DES_Auth
    rectangle "BucketService" as DES_Bucket
    rectangle "ObjectService" as DES_Object
    rectangle "UserService" as DES_User
    rectangle "InfrastructureService" as DES_Infra
    rectangle "EncryptionService" as DES_Encrypt
    rectangle "PolicyEvaluator" as DES_Policy
    rectangle "LocalStorageClient" as DES_Storage
}

' ==================== IMPLEMENTATION ====================
package "РЕАЛИЗАЦИЯ" #FFF3E0 {

    package "Controllers" {
        rectangle "AuthController" as IMP_AuthCtrl
        rectangle "BucketsController" as IMP_BucketCtrl
        rectangle "ObjectsController" as IMP_ObjectCtrl
        rectangle "InfraController" as IMP_InfraCtrl
    }

    package "Services" {
        rectangle "AuthService.cpp" as IMP_AuthSvc
        rectangle "BucketService.cpp" as IMP_BucketSvc
        rectangle "ObjectService.cpp" as IMP_ObjectSvc
        rectangle "EncryptionService.cpp" as IMP_EncryptSvc
        rectangle "PolicyEvaluator.cpp" as IMP_PolicySvc
    }

    package "Storage" {
        rectangle "LocalStorageClient.cpp" as IMP_LocalClient
        rectangle "MetadataManager.cpp" as IMP_MetaMgr
        rectangle "DatabaseManager.cpp" as IMP_DbMgr
    }
}

' ==================== TESTING ====================
package "ТЕСТИРОВАНИЕ" #FCE4EC {

    package "Unit Tests" {
        rectangle "auth_test.cpp" as TST_AuthUnit
        rectangle "bucket_test.cpp" as TST_BucketUnit
        rectangle "object_test.cpp" as TST_ObjectUnit
        rectangle "storage_test.cpp" as TST_StorageUnit
    }

    package "Integration Tests" {
        rectangle "auth_int_test.cpp" as TST_AuthInt
        rectangle "bucket_int_test.cpp" as TST_BucketInt
        rectangle "object_int_test.cpp" as TST_ObjectInt
    }

    package "E2E Tests" {
        rectangle "login.spec.ts" as TST_LoginE2E
        rectangle "bucket.spec.ts" as TST_BucketE2E
        rectangle "upload.spec.ts" as TST_UploadE2E
    }
}

' ==================== LINKS ====================

' Requirements -> Design
REQ001 --> DES_Auth
REQ002 --> DES_Auth
REQ003 --> DES_Policy
REQ004 --> DES_User

REQ005 --> DES_Bucket
REQ006 --> DES_Bucket
REQ007 --> DES_Encrypt
REQ008 --> DES_Policy

REQ010 --> DES_Object
REQ011 --> DES_Object
REQ012 --> DES_Object
REQ014 --> DES_Object

REQ016 --> DES_Infra
REQ017 --> DES_Infra
REQ018 --> DES_Infra

' Design -> Implementation
DES_Auth --> IMP_AuthCtrl
DES_Auth --> IMP_AuthSvc
DES_Bucket --> IMP_BucketCtrl
DES_Bucket --> IMP_BucketSvc
DES_Object --> IMP_ObjectCtrl
DES_Object --> IMP_ObjectSvc
DES_Infra --> IMP_InfraCtrl
DES_Encrypt --> IMP_EncryptSvc
DES_Policy --> IMP_PolicySvc
DES_Storage --> IMP_LocalClient
DES_Storage --> IMP_MetaMgr
DES_Storage --> IMP_DbMgr

' Implementation -> Tests
IMP_AuthSvc --> TST_AuthUnit
IMP_AuthCtrl --> TST_AuthInt
IMP_AuthCtrl --> TST_LoginE2E
IMP_BucketSvc --> TST_BucketUnit
IMP_BucketCtrl --> TST_BucketInt
IMP_BucketCtrl --> TST_BucketE2E
IMP_ObjectSvc --> TST_ObjectUnit
IMP_ObjectCtrl --> TST_ObjectInt
IMP_ObjectCtrl --> TST_UploadE2E
IMP_LocalClient --> TST_StorageUnit

@enduml
