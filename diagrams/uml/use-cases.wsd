@startuml use-cases
title Use Case Diagram: Object Storage Console

left to right direction
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor White
    BorderColor Black
    ArrowColor Gray
}

' ==================== ACTORS ====================
actor "Пользователь" as User
actor "Администратор" as Admin
actor "Внешняя система" as ExternalSystem

' Admin наследует от User
Admin --|> User

' ==================== SYSTEM BOUNDARY ====================
rectangle "Object Storage Console" {

    ' === Модуль аутентификации ===
    package "Модуль аутентификации" {
        usecase "UC-01\nАутентификация" as UC_Login
        usecase "UC-02\nВыход из системы" as UC_Logout
        usecase "UC-03\nСмена пароля" as UC_ChangePassword
        usecase "UC-04\nОбновление токена" as UC_RefreshToken
    }

    ' === Модуль управления бакетами ===
    package "Модуль управления бакетами" {
        usecase "UC-05\nПросмотр списка бакетов" as UC_ListBuckets
        usecase "UC-06\nСоздание бакета" as UC_CreateBucket
        usecase "UC-07\nУдаление бакета" as UC_DeleteBucket
        usecase "UC-08\nНастройка версионирования" as UC_ConfigureVersioning
        usecase "UC-09\nНастройка шифрования" as UC_ConfigureEncryption
        usecase "UC-10\nУстановка политики бакета" as UC_SetBucketPolicy
        usecase "UC-11\nУправление тегами бакета" as UC_SetBucketTags
        usecase "UC-12\nНастройка lifecycle правил" as UC_SetLifecycle
    }

    ' === Модуль управления объектами ===
    package "Модуль управления объектами" {
        usecase "UC-13\nПросмотр объектов" as UC_ListObjects
        usecase "UC-14\nЗагрузка объекта" as UC_UploadObject
        usecase "UC-15\nСкачивание объекта" as UC_DownloadObject
        usecase "UC-16\nУдаление объекта" as UC_DeleteObject
        usecase "UC-17\nКопирование объекта" as UC_CopyObject
        usecase "UC-18\nУправление тегами" as UC_SetObjectTags
        usecase "UC-19\nГенерация Presigned URL" as UC_GeneratePresigned
        usecase "UC-20\nПросмотр информации" as UC_ViewObjectInfo
    }

    ' === Модуль управления пользователями ===
    package "Модуль управления пользователями" {
        usecase "UC-21\nПросмотр пользователей" as UC_ListUsers
        usecase "UC-22\nСоздание пользователя" as UC_CreateUser
        usecase "UC-23\nУдаление пользователя" as UC_DeleteUser
        usecase "UC-24\nРедактирование" as UC_UpdateUser
        usecase "UC-25\nНазначение политики" as UC_AssignPolicy
        usecase "UC-26\nУправление группами" as UC_ManageGroups
    }

    ' === Модуль инфраструктуры ===
    package "Модуль инфраструктуры" {
        usecase "UC-27\nПросмотр серверов" as UC_ViewServers
        usecase "UC-28\nПросмотр дисков" as UC_ViewDrives
        usecase "UC-29\nПросмотр пулов" as UC_ViewPools
        usecase "UC-30\nЗапуск восстановления" as UC_StartHeal
        usecase "UC-31\nПросмотр статистики" as UC_ViewStats
    }

    ' === Модуль публичного доступа ===
    package "Модуль публичного доступа" {
        usecase "UC-32\nДоступ по Presigned URL" as UC_AccessPresigned
        usecase "UC-33\nЗагрузка по Presigned URL" as UC_UploadPresigned
    }
}

' ==================== ACTOR ASSOCIATIONS ====================

' Пользователь
User --> UC_Login
User --> UC_Logout
User --> UC_ChangePassword
User --> UC_ListBuckets
User --> UC_CreateBucket
User --> UC_ListObjects
User --> UC_UploadObject
User --> UC_DownloadObject
User --> UC_DeleteObject
User --> UC_CopyObject
User --> UC_SetObjectTags
User --> UC_GeneratePresigned
User --> UC_ViewObjectInfo

' Администратор (специфичные UC)
Admin --> UC_DeleteBucket
Admin --> UC_ConfigureVersioning
Admin --> UC_ConfigureEncryption
Admin --> UC_SetBucketPolicy
Admin --> UC_SetBucketTags
Admin --> UC_SetLifecycle
Admin --> UC_ListUsers
Admin --> UC_CreateUser
Admin --> UC_DeleteUser
Admin --> UC_UpdateUser
Admin --> UC_AssignPolicy
Admin --> UC_ManageGroups
Admin --> UC_ViewServers
Admin --> UC_ViewDrives
Admin --> UC_ViewPools
Admin --> UC_StartHeal
Admin --> UC_ViewStats

' Внешняя система
ExternalSystem --> UC_AccessPresigned
ExternalSystem --> UC_UploadPresigned
ExternalSystem --> UC_UploadObject
ExternalSystem --> UC_DownloadObject

' ==================== INCLUDE RELATIONSHIPS ====================
UC_UploadObject ..> UC_Login : <<include>>
UC_DownloadObject ..> UC_Login : <<include>>
UC_CreateBucket ..> UC_Login : <<include>>
UC_DeleteObject ..> UC_Login : <<include>>
UC_GeneratePresigned ..> UC_Login : <<include>>

' ==================== EXTEND RELATIONSHIPS ====================
UC_ConfigureEncryption ..> UC_UploadObject : <<extend>>
UC_ConfigureVersioning ..> UC_UploadObject : <<extend>>
UC_DeleteObject ..> UC_DeleteBucket : <<extend>>

@enduml
