@startuml state-object
title State Diagram: Жизненный цикл объекта в Object Storage

skinparam state {
    BackgroundColor White
    BorderColor Black
    ArrowColor Gray
}

[*] --> Uploading : Инициация загрузки

state Uploading {
    [*] --> Validating : Начало загрузки
    Validating --> Encrypting : Валидация пройдена
    Validating --> UploadFailed : Ошибка валидации
    Encrypting --> Writing : Шифрование завершено
    Writing --> CalculatingETag : Запись на диск
    CalculatingETag --> SavingMetadata : ETag вычислен
    SavingMetadata --> [*] : Метаданные сохранены
}

Uploading --> Active : Загрузка успешна
Uploading --> Failed : Ошибка загрузки

state Failed {
    [*] --> UploadFailed
    UploadFailed --> TempFileCleanup : Очистка
    TempFileCleanup --> [*]
}

Failed --> [*] : Очистка временных файлов

state Active {
    [*] --> Available
    Available --> BeingAccessed : GET запрос
    BeingAccessed --> Available : Доступ завершен
    Available --> BeingModified : Изменение метаданных
    BeingModified --> Available : Метаданные обновлены
}
note right of Active
    Основное рабочее состояние
    Доступен для чтения и записи
end note

Active --> Versioned : Новая версия загружена\n[versioning enabled]

state Versioned {
    [*] --> CurrentVersion
    CurrentVersion --> PreviousVersion : Новая версия загружена
    PreviousVersion --> CurrentVersion : Восстановление версии
    PreviousVersion --> VersionDeleted : Удаление версии
    VersionDeleted --> [*]
}
note right of Versioned
    История версий сохраняется
    Можно восстановить любую версию
end note

Versioned --> Active : Версия восстановлена

Active --> Locked : Включена блокировка\n[object-lock enabled]

state Locked {
    [*] --> GovernanceLock
    [*] --> ComplianceLock

    GovernanceLock --> [*] : Lock expired
    GovernanceLock --> ComplianceLock : Повышение до Compliance

    ComplianceLock --> [*] : Retention period ended
}
note right of Locked
    WORM Protection
    Нельзя удалить или изменить
    до истечения срока retention
end note

Locked --> Active : Блокировка снята

Active --> LegalHold : Установлен Legal Hold

state LegalHold {
    [*] --> HoldActive
    HoldActive --> [*] : Legal Hold снят
}
note right of LegalHold
    Юридическая защита
    Объект защищен от удаления
    независимо от retention
end note

LegalHold --> Active : Legal Hold снят

Active --> Archived : Lifecycle правило\n[transition to archive]

state Archived {
    [*] --> GlacierClass
    [*] --> DeepArchiveClass

    GlacierClass --> Restoring : Запрос на восстановление
    DeepArchiveClass --> Restoring : Запрос на восстановление

    Restoring --> RestoredTemporarily : Восстановлен
    RestoredTemporarily --> GlacierClass : Истек срок восстановления
    RestoredTemporarily --> DeepArchiveClass : Истек срок восстановления
}
note right of Archived
    Холодное хранение
    Низкая стоимость
    Время восстановления: 1-48 часов
end note

Archived --> Active : Перемещение в Standard

Active --> MarkedForDeletion : DELETE запрос

state MarkedForDeletion {
    [*] --> SoftDeleted : Мягкое удаление
    SoftDeleted --> DeleteMarker : Создан delete marker\n[versioning enabled]
    SoftDeleted --> PendingPermanentDeletion : Без версионирования

    DeleteMarker --> [*] : Версии сохранены
    PendingPermanentDeletion --> [*] : Объект удален
}

MarkedForDeletion --> Active : Восстановление из корзины
MarkedForDeletion --> PermanentlyDeleted : Постоянное удаление

state PermanentlyDeleted {
    [*] --> DataWiped : Данные удалены
    DataWiped --> MetadataRemoved : Метаданные очищены
    MetadataRemoved --> [*]
}

PermanentlyDeleted --> [*] : Объект полностью удален

@enduml
