@startuml activity-upload-as-is
title Activity Diagram: Загрузка файла AS-IS (Ручной процесс)

skinparam activity {
    BackgroundColor White
    BorderColor Black
    ArrowColor Gray
}

|#E3F2FD|Пользователь|
start

:Проверить наличие
файлового сервера в сети;

if (Сервер доступен?) then (Нет)
    |#FFCC80|IT-Поддержка|
    :Обратиться в IT-поддержку;
    :Ожидать восстановления сервера;
    note right
        Может занять
        от часов до дней
    end note
    |#E3F2FD|Пользователь|
else (Да)
endif

:Найти нужную папку на сервере;

if (Есть права доступа?) then (Нет)
    |#FFE082|IT-Администратор|
    :Отправить запрос на доступ
    администратору;

    :Ожидание одобрения от админа;
    note right
        Ручной процесс
        согласования
    end note

    :Получить учетные данные по email;

    |#E3F2FD|Пользователь|
    :Настроить FTP/SMB клиент вручную;
else (Да)
endif

:Выбрать файлы для загрузки;

repeat
    :Скопировать файлы на сервер вручную;

    :Ожидание завершения копирования;

    if (Копирование успешно?) then (Нет)
        :Обработать ошибку вручную;

        if (Повторить попытку?) then (Нет)
            #FFB6C1:Отмена загрузки;
            stop
        else (Да)
        endif
    else (Да)
        break
    endif
repeat while (Ошибка?) is (Да)

:Проверить целостность файла вручную;
note right
    Нет автоматической
    проверки MD5/SHA
end note

if (Файл корректен?) then (Нет)
    :Удалить поврежденный файл;
    :Повторить загрузку;
    detach
else (Да)
endif

:Уведомить команду по email о загрузке;

:Обновить документацию и журнал вручную;
note right
    Ручное ведение
    документации
end note

#90EE90:Файл загружен на сервер;
stop

@enduml
