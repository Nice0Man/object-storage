@startuml activity-share-as-is
title Activity Diagram: Предоставление доступа к файлу AS-IS (Ручной процесс)

skinparam activity {
    BackgroundColor White
    BorderColor Black
    ArrowColor Gray
}

|#E3F2FD|Владелец файла|
start

:Получить запрос на доступ от коллеги;

:Определить, какой файл нужен;

:Найти расположение файла на сервере;

if (Файл найден?) then (Нет)
    :Искать в резервных копиях;

    if (Найден в бэкапе?) then (Нет)
        #FFB6C1:Сообщить, что файл не найден;
        stop
    else (Да)
        :Восстановить файл из бэкапа;
    endif
else (Да)
endif

if (У получателя есть аккаунт?) then (Нет)
    |#FFE082|IT-Администратор|
    :Обратиться к IT-администратору;

    :Запросить создание аккаунта;

    :Ожидать создания аккаунта;
    note right
        Процесс занимает
        от часов до дней
    end note

    :Получить учетные данные
    нового аккаунта;
    |#E3F2FD|Владелец файла|
else (Да)
endif

switch (Выбрать способ доступа)
case (FTP доступ)
    |#FFF3E0|Настройка доступа|
    :Настроить права FTP вручную;
    :Установить права на папку;
    :Задокументировать в журнале;
    :Отправить FTP-реквизиты по email;

case (Сетевая папка)
    :Настроить права SMB вручную;
    :Добавить пользователя в группу доступа;
    :Задокументировать в журнале;
    :Отправить путь к папке по email;

case (Отправить файл)
    :Подготовить файл для отправки;

    while (Размер файла допустим?) is (Нет)
        :Сжать или разбить файл;
    endwhile (Да)

    :Отправить файл по email;
    note right
        Ограничение размера
        вложений email
    end note
endswitch

|#E3F2FD|Владелец файла|
:Подтвердить предоставление доступа;

:Уведомить запросившего о готовности;

while (Получатель подтвердил доступ?) is (Нет)
    :Помочь с устранением проблем;
    note right
        Ручная помощь
        с настройкой
    end note
endwhile (Да)

#90EE90:Доступ предоставлен;
stop

@enduml
