@startuml class-diagram
title Class Diagram: Object Storage Console - Сервисы и модели

skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor White
    BorderColor Black
    ArrowColor Gray
}

' ==================== INTERFACES ====================
interface IAuthService {
    +login(username: String, password: String): Result<LoginResponse>
    +logout(token: String): Result<void>
    +validateToken(token: String): Result<UserInfo>
    +refreshToken(token: String): Result<LoginResponse>
    +changePassword(userInfo: UserInfo, oldPwd: String, newPwd: String): Result<void>
}

interface IBucketService {
    +list_buckets(userInfo: UserInfo): Result<Vector<Bucket>>
    +create_bucket(userInfo: UserInfo, name: String, region: String, objectLocking: bool): Result<Bucket>
    +delete_bucket(userInfo: UserInfo, name: String): Result<void>
    +get_bucket_info(userInfo: UserInfo, name: String): Result<Bucket>
    +set_bucket_policy(userInfo: UserInfo, name: String, policy: String): Result<void>
    +get_bucket_versioning(userInfo: UserInfo, name: String): Result<bool>
    +set_bucket_encryption(userInfo: UserInfo, name: String, config: Json): Result<void>
}

interface IObjectService {
    +list_objects(userInfo: UserInfo, bucket: String, prefix: String): Result<Vector<Object>>
    +upload_object(userInfo: UserInfo, bucket: String, key: String, data: ByteArray): Result<Object>
    +download_object(userInfo: UserInfo, bucket: String, key: String): Result<ByteArray>
    +delete_object(userInfo: UserInfo, bucket: String, key: String): Result<void>
    +copy_object(userInfo: UserInfo, src: String, dst: String): Result<Object>
    +generate_presigned_url(userInfo: UserInfo, bucket: String, key: String): Result<String>
}

interface IUserService {
    +list_users(userInfo: UserInfo): Result<Vector<User>>
    +create_user(userInfo: UserInfo, username: String, password: String): Result<User>
    +delete_user(userInfo: UserInfo, accessKey: String): Result<void>
    +assign_policy(userInfo: UserInfo, accessKey: String, policy: String): Result<void>
}

interface IInfrastructureService {
    +get_summary(userInfo: UserInfo): Result<InfrastructureSummary>
    +list_servers(userInfo: UserInfo): Result<Vector<Server>>
    +list_drives(userInfo: UserInfo): Result<Vector<Drive>>
    +list_pools(userInfo: UserInfo): Result<Vector<Pool>>
    +start_heal(userInfo: UserInfo): Result<void>
}

interface IStorageClient {
    +put_object(bucket: String, key: String, data: ByteArray): Result<Object>
    +get_object(bucket: String, key: String): Result<ByteArray>
    +delete_object(bucket: String, key: String): Result<void>
    +list_objects(bucket: String, prefix: String): Result<Vector<Object>>
    +create_bucket(name: String, region: String): Result<bool>
    +delete_bucket(name: String): Result<void>
    +list_buckets(): Result<Vector<Bucket>>
}

' ==================== IMPLEMENTATIONS ====================
class AuthService {
    -jwt_secret: String
    -token_expiry: int
    -db_manager: DatabaseManager*
    +login(username: String, password: String): Result<LoginResponse>
    +validateToken(token: String): Result<UserInfo>
    -generateJWT(user: User): String
    -hashPassword(password: String): String
}

class BucketService {
    -storage_client: IStorageClient*
    -db_manager: DatabaseManager*
    -policy_evaluator: PolicyEvaluator*
    +list_buckets(userInfo: UserInfo): Result<Vector<Bucket>>
    +create_bucket(userInfo: UserInfo, name: String): Result<Bucket>
    -validateBucketName(name: String): bool
}

class ObjectService {
    -storage_client: IStorageClient*
    -policy_evaluator: PolicyEvaluator*
    -encryption_service: EncryptionService*
    -stats_collector: StatsCollector*
    +upload_object(...): Result<Object>
    +download_object(...): Result<ByteArray>
    -calculateETag(data: ByteArray): String
}

class UserService {
    -db_manager: DatabaseManager*
    -policy_evaluator: PolicyEvaluator*
    +list_users(userInfo: UserInfo): Result<Vector<User>>
    +create_user(...): Result<User>
    -generateAccessKey(): String
}

class InfrastructureService {
    -storage_client: IStorageClient*
    -stats_collector: StatsCollector*
    +get_summary(userInfo: UserInfo): Result<InfrastructureSummary>
    +list_servers(userInfo: UserInfo): Result<Vector<Server>>
}

class LocalStorageClient {
    -root_path: String
    -metadata_manager: MetadataManager*
    -path_manager: PathManager*
    +put_object(bucket: String, key: String, data: ByteArray): Result<Object>
    +get_object(bucket: String, key: String): Result<ByteArray>
    -atomicWrite(path: String, data: ByteArray): bool
}

' ==================== SUPPORT CLASSES ====================
class PolicyEvaluator {
    -db_manager: DatabaseManager*
    +evaluateAccess(userInfo: UserInfo, resource: String, action: String): AccessResult
    +loadBucketPolicy(bucket: String): Policy
    -matchResource(pattern: String, resource: String): bool
}

class EncryptionService {
    -encryption_key: ByteArray
    -algorithm: String
    +encrypt(data: ByteArray, algorithm: String): EncryptedData
    +decrypt(encryptedData: EncryptedData): ByteArray
    -generateIV(): ByteArray
}

class StatsCollector {
    -db_manager: DatabaseManager*
    +logActivity(action: String, bucket: String, key: String): void
    +getSystemStats(): SystemStats
    +getCapacityStats(): CapacityStats
}

class DatabaseManager {
    -db_path: String
    -connection: sqlite3*
    +initialize(): void
    +execute(query: String, params: Vector): Result<void>
    +query(sql: String, params: Vector): Result<Vector<Row>>
    +beginTransaction(): void
    +commit(): void
}

class MetadataManager {
    -db_manager: DatabaseManager*
    +loadObjectMetadata(bucket: String, key: String): ObjectMetadata
    +saveObjectMetadata(metadata: ObjectMetadata): void
    +loadBucketMetadata(bucket: String): BucketMetadata
}

class PathManager {
    -storage_root: String
    +getBucketPath(bucket: String): String
    +getObjectPath(bucket: String, key: String): String
    +getMetadataPath(bucket: String, key: String): String
    +ensureDirectoryExists(path: String): void
}

' ==================== MODELS ====================
class Bucket << entity >> {
    -name: String
    -creation_date: TimePoint
    -region: String
    -versioning: bool
    -encryption: bool
    -object_lock: bool
    -size: int64
    +to_json(): Json
    +{static} from_json(json: Json): Bucket
}

class Object << entity >> {
    -key: String
    -bucket: String
    -size: int64
    -etag: String
    -content_type: String
    -last_modified: TimePoint
    -encrypted: bool
    +to_json(): Json
    +{static} from_json(json: Json): Object
    +is_directory(): bool
}

class User << entity >> {
    -username: String
    -access_key: String
    -secret_key: String
    -is_admin: bool
    -status: UserStatus
    -policies: Vector<String>
    +to_json(): Json
    +{static} from_json(json: Json): User
}

class Policy << entity >> {
    -name: String
    -version: String
    -statements: Vector<Statement>
    +to_json(): Json
    +{static} from_json(json: Json): Policy
    +evaluate(action: String, resource: String): AccessResult
}

class Server << entity >> {
    -id: String
    -hostname: String
    -endpoint: String
    -status: ServerStatus
    -drives_count: int
    +to_json(): Json
}

class Drive << entity >> {
    -id: String
    -server_id: String
    -path: String
    -status: DriveStatus
    -total_space: int64
    -used_space: int64
    +to_json(): Json
}

class Pool << entity >> {
    -id: String
    -name: String
    -status: PoolStatus
    -servers: Vector<String>
    -total_capacity: int64
    -used_capacity: int64
    +to_json(): Json
}

' ==================== RELATIONSHIPS ====================

' Interface Realizations
IAuthService <|.. AuthService
IBucketService <|.. BucketService
IObjectService <|.. ObjectService
IUserService <|.. UserService
IInfrastructureService <|.. InfrastructureService
IStorageClient <|.. LocalStorageClient

' Dependencies
AuthService ..> DatabaseManager : <<use>>
BucketService ..> IStorageClient : <<use>>
BucketService ..> DatabaseManager : <<use>>
BucketService ..> PolicyEvaluator : <<use>>
ObjectService ..> IStorageClient : <<use>>
ObjectService ..> PolicyEvaluator : <<use>>
ObjectService ..> EncryptionService : <<use>>
ObjectService ..> StatsCollector : <<use>>
UserService ..> DatabaseManager : <<use>>
UserService ..> PolicyEvaluator : <<use>>
InfrastructureService ..> IStorageClient : <<use>>
InfrastructureService ..> StatsCollector : <<use>>

LocalStorageClient ..> MetadataManager : <<use>>
LocalStorageClient ..> PathManager : <<use>>
MetadataManager ..> DatabaseManager : <<use>>

PolicyEvaluator ..> DatabaseManager : <<use>>
StatsCollector ..> DatabaseManager : <<use>>

' Creation dependencies
ObjectService ..> Object : <<create>>
BucketService ..> Bucket : <<create>>
UserService ..> User : <<create>>

' Aggregations
Bucket "1" o-- "0..*" Object : contains
Server "1" o-- "1..*" Drive : has
Pool "1" o-- "1..*" Server : includes
User "1" o-- "0..*" Policy : assigned

@enduml
