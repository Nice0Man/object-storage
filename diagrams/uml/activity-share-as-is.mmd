---
title: "Activity Diagram: Предоставление доступа к файлу AS-IS (Ручной процесс)"
config:
  theme: default
---
flowchart TD
    %% ==================== LEGEND ====================
    subgraph legend ["📋 Легенда UML Activity"]
        direction LR
        L_Start(( )):::startEnd
        L_End((◉)):::finalEnd
        L_Action["Действие"]:::action
        L_Decision{"Решение"}:::decision
    end

    %% ==================== USER WHO SHARES ====================
    subgraph owner_lane ["👤 Владелец файла"]
        direction TB
        Start(( )):::startEnd
        Start --> ReceiveRequest["📨 Получить запрос на доступ<br/>от коллеги"]

        ReceiveRequest --> IdentifyFile["🔍 Определить,<br/>какой файл нужен"]

        IdentifyFile --> FindFileLocation["📂 Найти расположение<br/>файла на сервере"]

        FindFileLocation --> FileFound{"Файл<br/>найден?"}

        FileFound -->|Нет| SearchBackup["🗄️ Искать в<br/>резервных копиях"]
        SearchBackup --> BackupFound{"Найден<br/>в бэкапе?"}
        BackupFound -->|Нет| NotifyNotFound["❌ Сообщить, что<br/>файл не найден"]
        NotifyNotFound --> EndNotFound((◉)):::errorEnd
        BackupFound -->|Да| RestoreFromBackup["♻️ Восстановить файл<br/>из бэкапа"]
        RestoreFromBackup --> FindFileLocation

        FileFound -->|Да| CheckUserAccount{"У получателя<br/>есть аккаунт?"}
    end

    %% ==================== IT ADMIN ====================
    subgraph admin_lane ["👔 IT-Администратор"]
        direction TB
        CheckUserAccount -->|Нет| ContactAdmin["📞 Обратиться к<br/>IT-администратору"]
        ContactAdmin --> RequestAccountCreation["📝 Запросить создание<br/>аккаунта"]
        RequestAccountCreation --> WaitAccountCreation["⏳ Ожидать<br/>создания аккаунта"]
        WaitAccountCreation --> ReceiveCredentials["📧 Получить учетные данные<br/>нового аккаунта"]
        ReceiveCredentials --> AccountReady["✅ Аккаунт готов"]
    end

    %% ==================== ACCESS CONFIGURATION ====================
    subgraph config_lane ["⚙️ Настройка доступа"]
        direction TB
        CheckUserAccount -->|Да| DetermineAccessMethod{"Выбрать способ<br/>доступа"}
        AccountReady --> DetermineAccessMethod

        %% FTP Path
        DetermineAccessMethod -->|FTP доступ| ConfigureFTPAccess["🔧 Настроить права<br/>FTP вручную"]
        ConfigureFTPAccess --> SetFTPPermissions["📋 Установить права<br/>на папку"]
        SetFTPPermissions --> DocumentFTPAccess["📝 Задокументировать<br/>в журнале"]
        DocumentFTPAccess --> SendFTPCredentials["📧 Отправить FTP-реквизиты<br/>по email"]
        SendFTPCredentials --> ConfirmAccess

        %% SMB Path
        DetermineAccessMethod -->|Сетевая папка| ConfigureSMBAccess["🔧 Настроить права<br/>SMB вручную"]
        ConfigureSMBAccess --> SetSMBPermissions["👥 Добавить пользователя<br/>в группу доступа"]
        SetSMBPermissions --> DocumentSMBAccess["📝 Задокументировать<br/>в журнале"]
        DocumentSMBAccess --> SendSMBPath["📧 Отправить путь к папке<br/>по email"]
        SendSMBPath --> ConfirmAccess

        %% Email Path
        DetermineAccessMethod -->|Отправить файл| PrepareFile["📎 Подготовить файл<br/>для отправки"]
        PrepareFile --> CheckFileSize{"Размер файла<br/>допустим?"}
        CheckFileSize -->|Нет: слишком большой| CompressFile["🗜️ Сжать или<br/>разбить файл"]
        CompressFile --> CheckFileSize
        CheckFileSize -->|Да| SendByEmail["📧 Отправить файл<br/>по email"]
        SendByEmail --> ConfirmAccess
    end

    %% ==================== CONFIRMATION ====================
    subgraph confirm_lane ["✅ Подтверждение"]
        direction TB
        ConfirmAccess["📋 Подтвердить<br/>предоставление доступа"]

        ConfirmAccess --> NotifyRequester["📨 Уведомить запросившего<br/>о готовности"]

        NotifyRequester --> VerifyAccess{"Получатель<br/>подтвердил доступ?"}

        VerifyAccess -->|Нет| TroubleshootAccess["🔧 Помочь с устранением<br/>проблем"]
        TroubleshootAccess --> VerifyAccess

        VerifyAccess -->|Да| EndSuccess((◉)):::successEnd
    end

    %% ==================== NOTES ====================
    N1>"⏱️ Процесс занимает<br/>от часов до дней"]
    WaitAccountCreation -.-> N1

    N2>"⚠️ Нет единой<br/>точки управления"]
    DetermineAccessMethod -.-> N2

    %% ==================== STYLING ====================
    classDef startEnd fill:#000000,stroke:#000000,color:#000000
    classDef successEnd fill:#4CAF50,stroke:#2E7D32,color:#ffffff
    classDef errorEnd fill:#F44336,stroke:#C62828,color:#ffffff
    classDef action fill:#FFFFFF,stroke:#424242,stroke-width:1px
    classDef decision fill:#FFFFFF,stroke:#424242,stroke-width:1px
    classDef warning fill:#FFCC80,stroke:#EF6C00
    classDef wait fill:#FFE082,stroke:#FF8F00
    classDef note fill:#FFF9C4,stroke:#F9A825,stroke-width:1px

    class Start startEnd
    class EndSuccess successEnd
    class EndNotFound errorEnd
    class WaitAccountCreation wait
    class ContactAdmin,TroubleshootAccess warning
    class N1,N2 note
