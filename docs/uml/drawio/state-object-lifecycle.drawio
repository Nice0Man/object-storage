        <!-- ========== TRANSITIONS ========== -->

        <!-- Initial -> Uploading -->
        <mxCell id="trans1" value="upload()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;" edge="1" parent="1" source="initial" target="state_uploading">
