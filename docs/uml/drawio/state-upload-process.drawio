          <mxGeometry x="140" y="110" width="90" height="50" as="geometry" />
        </mxCell>

        <!-- Internal transitions in composite -->
        <mxCell id="t_reading_buffering" style="endArrow=block;html=1;rounded=0;fontSize=8;entryX=0;entryY=0.5;exitX=1;exitY=0.5;" edge="1" parent="state_transfer" source="state_reading" target="state_buffering">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t_buffering_writing" style="endArrow=block;html=1;rounded=0;fontSize=8;entryX=0;entryY=0.5;exitX=1;exitY=0.5;" edge="1" parent="state_transfer" source="state_buffering" target="state_writing">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t_writing_progress" style="endArrow=block;html=1;rounded=0;fontSize=8;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="state_transfer" source="state_writing" target="state_progress">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="290" y="135" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="t_progress_reading" value="[hasMoreData]" style="endArrow=block;html=1;rounded=0;fontSize=8;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="state_transfer" source="state_progress" target="state_reading">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="75" y="135" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- State: Финализация -->
        <mxCell id="state_finalizing" value="Финализация&#xa;(Finalizing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="220" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="state_finalizing_actions" value="entry / вычислить ETag&#xa;do / закрыть temp файл&#xa;exit / выполнить rename" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="840" y="280" width="130" height="50" as="geometry" />
        </mxCell>

        <!-- State: Завершён -->
        <mxCell id="state_completed" value="Завершён&#xa;(Completed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1010" y="220" width="100" height="60" as="geometry" />
        </mxCell>

        <!-- State: Ошибка -->
        <mxCell id="state_error" value="Ошибка&#xa;(Error)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="400" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="state_error_actions" value="entry / логировать ошибку&#xa;do / очистить temp файлы" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="560" y="460" width="140" height="40" as="geometry" />
        </mxCell>

        <!-- State: Отменён -->
        <mxCell id="state_cancelled" value="Отменён&#xa;(Cancelled)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="400" width="100" height="60" as="geometry" />
        </mxCell>

        <!-- State: Повтор -->
        <mxCell id="state_retrying" value="Повтор&#xa;(Retrying)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="400" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="state_retrying_actions" value="entry / сбросить позицию&#xa;do / wait(backoff)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="760" y="460" width="110" height="40" as="geometry" />
        </mxCell>

        <!-- Final State: Success -->
        <mxCell id="final_success" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#82b366;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1045" y="330" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="final_success_outer" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=none;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1040" y="325" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="final_success_label" value="Успех" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1035" y="365" width="50" height="20" as="geometry" />
        </mxCell>

        <!-- Final State: Failure -->
        <mxCell id="final_failure" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#b85450;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="595" y="530" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="final_failure_outer" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=none;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="590" y="525" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="final_failure_label" value="Неудача" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="585" y="565" width="50" height="20" as="geometry" />
        </mxCell>

        <!-- Final State: Cancelled -->
        <mxCell id="final_cancelled" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#9673a6;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="395" y="530" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="final_cancelled_outer" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=none;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="390" y="525" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- Transitions -->
        <!-- Initial -> Idle -->
        <mxCell id="t1" style="endArrow=block;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="initial" target="state_idle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Idle -> Initializing -->
        <mxCell id="t2" value="startUpload(file)" style="endArrow=block;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="state_idle" target="state_init">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Initializing -> Transferring -->
        <mxCell id="t3" value="initialized" style="endArrow=block;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="state_init" target="state_transfer">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="410" y="250" />
              <mxPoint x="410" y="180" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Transferring -> Finalizing -->
        <mxCell id="t4" value="allDataTransferred" style="endArrow=block;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="state_transfer" target="state_finalizing">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="820" y="180" />
              <mxPoint x="820" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Finalizing -> Completed -->
        <mxCell id="t5" value="finalized" style="endArrow=block;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="state_finalizing" target="state_completed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Completed -> Final Success -->
        <mxCell id="t6" style="endArrow=block;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="state_completed" target="final_success">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Error transitions (from any state) -->
        <!-- Initializing -> Error -->
        <mxCell id="t7" value="error" style="endArrow=block;html=1;rounded=0;fontSize=9;strokeColor=#b85450;" edge="1" parent="1" source="state_init" target="state_error">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="330" y="400" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Transferring -> Error -->
        <mxCell id="t8" value="networkError /&#xa;timeout" style="endArrow=block;html=1;rounded=0;fontSize=9;strokeColor=#b85450;" edge="1" parent="1" source="state_transfer" target="state_error">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="610" y="320" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Error -> Retrying [retryable] -->
        <mxCell id="t9" value="[retryCount &lt; maxRetries]" style="endArrow=block;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="state_error" target="state_retrying">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Retrying -> Transferring -->
        <mxCell id="t10" value="retry()" style="endArrow=block;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="state_retrying" target="state_transfer">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="810" y="320" />
              <mxPoint x="810" y="180" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Error -> Final Failure -->
        <mxCell id="t11" value="[retryCount &gt;= maxRetries]" style="endArrow=block;html=1;rounded=0;fontSize=9;strokeColor=#b85450;" edge="1" parent="1" source="state_error" target="final_failure">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Cancel transitions -->
        <!-- Transferring -> Cancelled -->
        <mxCell id="t12" value="cancel()" style="endArrow=block;html=1;rounded=0;fontSize=9;strokeColor=#9673a6;" edge="1" parent="1" source="state_transfer" target="state_cancelled">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="440" y="320" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Cancelled -> Final Cancelled -->
        <mxCell id="t13" style="endArrow=block;html=1;rounded=0;fontSize=9;strokeColor=#9673a6;" edge="1" parent="1" source="state_cancelled" target="final_cancelled">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Progress bar representation -->
        <mxCell id="progress_note" value="События прогресса:&#xa;progressUpdate(bytesTransferred, totalBytes)&#xa;→ WebSocket: upload-progress" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffe6cc;strokeColor=#d79b00;size=14;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;Легенда:&lt;/b&gt;&#xa;⬛ Начальное/Конечное состояние&#xa;▭ Простое состояние&#xa;⬜ Составное состояние&#xa;[guard] Условие перехода&#xa;🔴 Путь ошибки&#xa;🟣 Путь отмены" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="180" height="110" as="geometry" />
        </mxCell>

