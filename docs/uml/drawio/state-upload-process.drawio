  <diagram name="State Diagram - Upload Process" id="state-upload-process">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Диаграмма состояний: Процесс загрузки объекта (Upload Process)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- Initial State -->
        <mxCell id="initial" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="60" y="235" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- State: Ожидание -->
        <mxCell id="state_idle" value="Ожидание&#xa;(Idle)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="220" width="100" height="60" as="geometry" />
        </mxCell>

        <!-- State: Инициализация -->
        <mxCell id="state_init" value="Инициализация&#xa;(Initializing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="220" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="state_init_actions" value="entry / создать UploadRequest&#xa;do / валидировать параметры&#xa;exit / инициализировать буфер" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="270" y="280" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- Composite State: Передача данных -->
        <mxCell id="state_transfer" value="Передача данных (Transferring)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=20;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="80" width="350" height="200" as="geometry" />
        </mxCell>

        <!-- Sub-state: Чтение chunk -->
        <mxCell id="state_reading" value="Чтение chunk&#xa;(Reading)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="state_transfer">
          <mxGeometry x="30" y="40" width="90" height="50" as="geometry" />
        </mxCell>

        <!-- Sub-state: Буферизация -->
        <mxCell id="state_buffering" value="Буферизация&#xa;(Buffering)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="state_transfer">
          <mxGeometry x="140" y="40" width="90" height="50" as="geometry" />
        </mxCell>

        <!-- Sub-state: Запись -->
        <mxCell id="state_writing" value="Запись&#xa;(Writing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="state_transfer">
          <mxGeometry x="250" y="40" width="80" height="50" as="geometry" />
        </mxCell>

        <!-- Sub-state: Обновление прогресса -->
