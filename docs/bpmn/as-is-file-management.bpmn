<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AsIs" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.42.0">
  <bpmn:process id="Process_AsIs_FileManagement" name="Процесс загрузки файла (AS IS)" isExecutable="true">
    <bpmn:startEvent id="Event_Start" name="Необходимо загрузить файл">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_CheckAccess" name="1. Проверить наличие доступа к серверу">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_HasAccess" name="Есть доступ?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_3_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RequestAccess" name="2. Отправить запрос на доступ">
      <bpmn:incoming>Flow_3_No</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CheckUser" name="3. Проверить пользователя">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_UserExists" name="Есть аккаунт?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_6_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CreateAccount" name="4. Создать аккаунт вручную">
      <bpmn:incoming>Flow_6_No</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_MergeAccount" name="">
      <bpmn:incoming>Flow_6_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ConfigurePermissions" name="5. Настроить права доступа вручную">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SendCredentials" name="6. Отправить учетные данные">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ConfigureClient" name="7. Настроить клиент вручную">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_MergeAccess" name="">
      <bpmn:incoming>Flow_3_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_FindFolder" name="8. Найти нужную папку на сервере">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_BeforeUpload" name="">
      <bpmn:incoming>Flow_Retry</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_UploadFile" name="9. Скопировать файл на сервер вручную">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_UploadSuccess" name="Загрузка успешна?">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_16_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RetryUpload" name="10. Повторить попытку загрузки">
      <bpmn:incoming>Flow_16_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SaveFile" name="11. Сохранить файл на диск">
      <bpmn:incoming>Flow_16_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ManualBackup" name="12. Ручное резервирование">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_NotifyUser" name="13. Уведомить пользователя">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_End" name="Файл загружен">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Task_CheckAccess" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CheckAccess" targetRef="Gateway_HasAccess" />
    <bpmn:sequenceFlow id="Flow_3_Yes" name="Да" sourceRef="Gateway_HasAccess" targetRef="Gateway_MergeAccess" />
    <bpmn:sequenceFlow id="Flow_3_No" name="Нет" sourceRef="Gateway_HasAccess" targetRef="Task_RequestAccess" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_RequestAccess" targetRef="Task_CheckUser" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_CheckUser" targetRef="Gateway_UserExists" />
    <bpmn:sequenceFlow id="Flow_6_Yes" name="Да" sourceRef="Gateway_UserExists" targetRef="Gateway_MergeAccount" />
    <bpmn:sequenceFlow id="Flow_6_No" name="Нет" sourceRef="Gateway_UserExists" targetRef="Task_CreateAccount" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_CreateAccount" targetRef="Gateway_MergeAccount" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_MergeAccount" targetRef="Task_ConfigurePermissions" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_ConfigurePermissions" targetRef="Task_SendCredentials" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_SendCredentials" targetRef="Task_ConfigureClient" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ConfigureClient" targetRef="Gateway_MergeAccess" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_MergeAccess" targetRef="Task_FindFolder" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_FindFolder" targetRef="Gateway_BeforeUpload" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_BeforeUpload" targetRef="Task_UploadFile" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_UploadFile" targetRef="Gateway_UploadSuccess" />
    <bpmn:sequenceFlow id="Flow_16_Yes" name="Да" sourceRef="Gateway_UploadSuccess" targetRef="Task_SaveFile" />
    <bpmn:sequenceFlow id="Flow_16_No" name="Нет" sourceRef="Gateway_UploadSuccess" targetRef="Task_RetryUpload" />
    <bpmn:sequenceFlow id="Flow_Retry" sourceRef="Task_RetryUpload" targetRef="Gateway_BeforeUpload" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_SaveFile" targetRef="Task_ManualBackup" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_ManualBackup" targetRef="Task_NotifyUser" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_NotifyUser" targetRef="Event_End" />
  </bpmn:process>
