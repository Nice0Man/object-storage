<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ToBe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.42.0">
  <bpmn:collaboration id="Collaboration_ToBe">
    <bpmn:participant id="Participant_User" name="Пользователь" processRef="Process_User" />
    <bpmn:participant id="Participant_Console" name="Object Storage Servises" processRef="Process_Console" />
    <bpmn:participant id="Participant_Backend" name="Storage Backend" processRef="Process_Backend" />
    <bpmn:messageFlow id="Flow_Auth" name="Логин/Пароль" sourceRef="Task_Login" targetRef="Task_ValidateCredentials" />
    <bpmn:messageFlow id="Flow_AuthResponse" name="JWT Token" sourceRef="Task_GenerateToken" targetRef="Event_AuthSuccess" />
    <bpmn:messageFlow id="Flow_Upload" name="Multipart Upload" sourceRef="Task_DragDrop" targetRef="Task_ValidateRequest" />
    <bpmn:messageFlow id="Flow_Store" name="Store Object" sourceRef="Task_ProcessUpload" targetRef="Task_CalcEtag" />
    <bpmn:messageFlow id="Flow_StoreResponse" name="ETag" sourceRef="Task_SaveToStorage" targetRef="Event_StoreSuccess" />
    <bpmn:messageFlow id="Flow_UploadResponse" name="200 OK" sourceRef="Task_ReturnResult" targetRef="Event_UploadSuccess" />
    <bpmn:messageFlow id="Flow_ErrorResponse" name="403 Forbidden" sourceRef="Task_ReturnError" targetRef="Event_UploadError" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="true">
    <bpmn:startEvent id="Event_Start_User" name="Необходимо загрузить файл">
      <bpmn:outgoing>Flow_U1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_OpenBrowser" name="Открыть веб-интерфейс Object Storage">
      <bpmn:incoming>Flow_U1</bpmn:incoming>
      <bpmn:outgoing>Flow_U2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Login" name="Ввести логин и пароль">
      <bpmn:incoming>Flow_U2</bpmn:incoming>
      <bpmn:outgoing>Flow_U3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_AuthSuccess" name="Получить JWT токен">
      <bpmn:incoming>Flow_U3</bpmn:incoming>
      <bpmn:outgoing>Flow_U4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_Auth" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_SelectBucket" name="Выбрать бакет">
      <bpmn:incoming>Flow_U4</bpmn:incoming>
      <bpmn:outgoing>Flow_U5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DragDrop" name="Drag and Drop файла">
      <bpmn:incoming>Flow_U5</bpmn:incoming>
      <bpmn:outgoing>Flow_U6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="Gateway_WaitResponse" name="Ожидание ответа">
      <bpmn:incoming>Flow_U6</bpmn:incoming>
      <bpmn:outgoing>Flow_U6a</bpmn:outgoing>
      <bpmn:outgoing>Flow_U6b</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:exclusiveGateway id="Gateway_MergeUser" name="">
      <bpmn:incoming>Flow_U8_No</bpmn:incoming>
      <bpmn:incoming>Flow_U10</bpmn:incoming>
      <bpmn:outgoing>Flow_U11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_End_User" name="Операция завершена">
      <bpmn:incoming>Flow_U11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Event_UploadError" name="Ошибка доступа">
      <bpmn:incoming>Flow_U6b</bpmn:incoming>
      <bpmn:outgoing>Flow_U7_Error</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_Error" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_NeedShare" name="Поделиться файлом?">
      <bpmn:incoming>Flow_U7</bpmn:incoming>
      <bpmn:outgoing>Flow_U8_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_U8_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_UploadSuccess" name="Успешная загрузка">
      <bpmn:incoming>Flow_U6a</bpmn:incoming>
      <bpmn:outgoing>Flow_U7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_Upload" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Event_End_Error" name="Загрузка отклонена">
      <bpmn:incoming>Flow_U7_Error</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_ShareLink" name="Отправить ссылку коллегам">
      <bpmn:incoming>Flow_U9</bpmn:incoming>
      <bpmn:outgoing>Flow_U10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GeneratePresigned" name="Сгенерировать Presigned URL">
      <bpmn:incoming>Flow_U8_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_U9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_U1" sourceRef="Event_Start_User" targetRef="Task_OpenBrowser" />
    <bpmn:sequenceFlow id="Flow_U2" sourceRef="Task_OpenBrowser" targetRef="Task_Login" />
    <bpmn:sequenceFlow id="Flow_U3" sourceRef="Task_Login" targetRef="Event_AuthSuccess" />
    <bpmn:sequenceFlow id="Flow_U4" sourceRef="Event_AuthSuccess" targetRef="Task_SelectBucket" />
    <bpmn:sequenceFlow id="Flow_U5" sourceRef="Task_SelectBucket" targetRef="Task_DragDrop" />
    <bpmn:sequenceFlow id="Flow_U6" sourceRef="Task_DragDrop" targetRef="Gateway_WaitResponse" />
    <bpmn:sequenceFlow id="Flow_U6a" sourceRef="Gateway_WaitResponse" targetRef="Event_UploadSuccess" />
    <bpmn:sequenceFlow id="Flow_U6b" sourceRef="Gateway_WaitResponse" targetRef="Event_UploadError" />
    <bpmn:sequenceFlow id="Flow_U8_No" name="Нет" sourceRef="Gateway_NeedShare" targetRef="Gateway_MergeUser" />
    <bpmn:sequenceFlow id="Flow_U10" sourceRef="Task_ShareLink" targetRef="Gateway_MergeUser" />
    <bpmn:sequenceFlow id="Flow_U11" sourceRef="Gateway_MergeUser" targetRef="Event_End_User" />
    <bpmn:sequenceFlow id="Flow_U7_Error" sourceRef="Event_UploadError" targetRef="Event_End_Error" />
    <bpmn:sequenceFlow id="Flow_U7" sourceRef="Event_UploadSuccess" targetRef="Gateway_NeedShare" />
    <bpmn:sequenceFlow id="Flow_U8_Yes" name="Да" sourceRef="Gateway_NeedShare" targetRef="Task_GeneratePresigned" />
    <bpmn:sequenceFlow id="Flow_U9" sourceRef="Task_GeneratePresigned" targetRef="Task_ShareLink" />
  </bpmn:process>
  <bpmn:process id="Process_Console" isExecutable="false">
    <bpmn:serviceTask id="Task_ValidateCredentials" name="Валидация учетных данных">
      <bpmn:outgoing>Flow_C1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GenerateToken" name="Генерация JWT токена">
      <bpmn:incoming>Flow_C1</bpmn:incoming>
      <bpmn:outgoing>Flow_C2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_End_Auth" name="Аутентификация завершена">
      <bpmn:incoming>Flow_C2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_ValidateRequest" name="Валидация JWT и прав доступа">
      <bpmn:outgoing>Flow_C4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Валидация пройдена?">
      <bpmn:incoming>Flow_C4</bpmn:incoming>
      <bpmn:outgoing>Flow_C5_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_C5_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ReturnError" name="Возврат ошибки 403">
      <bpmn:incoming>Flow_C5_No</bpmn:incoming>
      <bpmn:outgoing>Flow_C11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_End_Error_Console" name="Ошибка обработана">
      <bpmn:incoming>Flow_C11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_ProcessUpload" name="Обработка загрузки объекта">
      <bpmn:incoming>Flow_C5_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_C6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_StoreSuccess" name="Объект сохранен">
      <bpmn:incoming>Flow_C6</bpmn:incoming>
      <bpmn:outgoing>Flow_C7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_StoreResp" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_SaveMetadata" name="Сохранение метаданных в БД">
      <bpmn:incoming>Flow_C7</bpmn:incoming>
      <bpmn:outgoing>Flow_C8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_LogActivity" name="Логирование операции">
      <bpmn:incoming>Flow_C8</bpmn:incoming>
      <bpmn:outgoing>Flow_C9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ReturnResult" name="Возврат успешного результата">
      <bpmn:incoming>Flow_C9</bpmn:incoming>
      <bpmn:outgoing>Flow_C10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_End_Upload" name="Загрузка завершена">
      <bpmn:incoming>Flow_C10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_C1" sourceRef="Task_ValidateCredentials" targetRef="Task_GenerateToken" />
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="Task_GenerateToken" targetRef="Event_End_Auth" />
    <bpmn:sequenceFlow id="Flow_C4" sourceRef="Task_ValidateRequest" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="Flow_C5_Yes" name="Да" sourceRef="Gateway_Valid" targetRef="Task_ProcessUpload" />
    <bpmn:sequenceFlow id="Flow_C5_No" name="Нет" sourceRef="Gateway_Valid" targetRef="Task_ReturnError" />
    <bpmn:sequenceFlow id="Flow_C11" sourceRef="Task_ReturnError" targetRef="Event_End_Error_Console" />
    <bpmn:sequenceFlow id="Flow_C6" sourceRef="Task_ProcessUpload" targetRef="Event_StoreSuccess" />
    <bpmn:sequenceFlow id="Flow_C7" sourceRef="Event_StoreSuccess" targetRef="Task_SaveMetadata" />
    <bpmn:sequenceFlow id="Flow_C8" sourceRef="Task_SaveMetadata" targetRef="Task_LogActivity" />
    <bpmn:sequenceFlow id="Flow_C9" sourceRef="Task_LogActivity" targetRef="Task_ReturnResult" />
    <bpmn:sequenceFlow id="Flow_C10" sourceRef="Task_ReturnResult" targetRef="Event_End_Upload" />
  </bpmn:process>
  <bpmn:process id="Process_Backend" isExecutable="false">
    <bpmn:exclusiveGateway id="Gateway_MergeVersion" name="">
      <bpmn:incoming>Flow_B7_No</bpmn:incoming>
      <bpmn:incoming>Flow_B8</bpmn:incoming>
      <bpmn:outgoing>Flow_B9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CreateVersion" name="Создать новую версию">
      <bpmn:incoming>Flow_B7_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_B8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Versioning" name="Версионирование?">
      <bpmn:incoming>Flow_B6</bpmn:incoming>
      <bpmn:outgoing>Flow_B7_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_B7_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_WriteMetaFile" name="Запись .meta файла">
      <bpmn:incoming>Flow_B5</bpmn:incoming>
      <bpmn:outgoing>Flow_B6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SaveToStorage" name="Атомарная запись на диск">
      <bpmn:incoming>Flow_B4</bpmn:incoming>
      <bpmn:outgoing>Flow_B5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MergeBackend" name="">
      <bpmn:incoming>Flow_B2_No</bpmn:incoming>
      <bpmn:incoming>Flow_B3</bpmn:incoming>
      <bpmn:outgoing>Flow_B4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Encrypt" name="Шифрование данных (AES-256)">
      <bpmn:incoming>Flow_B2_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_B3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Encryption" name="Шифрование включено?">
      <bpmn:incoming>Flow_B1</bpmn:incoming>
      <bpmn:outgoing>Flow_B2_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_B2_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CalcEtag" name="Вычисление ETag (MD5)">
      <bpmn:outgoing>Flow_B1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_End_Backend" name="Объект сохранен">
      <bpmn:incoming>Flow_B9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_B7_No" name="Нет" sourceRef="Gateway_Versioning" targetRef="Gateway_MergeVersion" />
    <bpmn:sequenceFlow id="Flow_B8" sourceRef="Task_CreateVersion" targetRef="Gateway_MergeVersion" />
    <bpmn:sequenceFlow id="Flow_B9" sourceRef="Gateway_MergeVersion" targetRef="Event_End_Backend" />
    <bpmn:sequenceFlow id="Flow_B7_Yes" name="Да" sourceRef="Gateway_Versioning" targetRef="Task_CreateVersion" />
    <bpmn:sequenceFlow id="Flow_B6" sourceRef="Task_WriteMetaFile" targetRef="Gateway_Versioning" />
    <bpmn:sequenceFlow id="Flow_B5" sourceRef="Task_SaveToStorage" targetRef="Task_WriteMetaFile" />
    <bpmn:sequenceFlow id="Flow_B4" sourceRef="Gateway_MergeBackend" targetRef="Task_SaveToStorage" />
    <bpmn:sequenceFlow id="Flow_B2_No" name="Нет" sourceRef="Gateway_Encryption" targetRef="Gateway_MergeBackend" />
    <bpmn:sequenceFlow id="Flow_B3" sourceRef="Task_Encrypt" targetRef="Gateway_MergeBackend" />
    <bpmn:sequenceFlow id="Flow_B2_Yes" name="Да" sourceRef="Gateway_Encryption" targetRef="Task_Encrypt" />
    <bpmn:sequenceFlow id="Flow_B1" sourceRef="Task_CalcEtag" targetRef="Gateway_Encryption" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ToBe">
    <bpmndi:BPMNPlane id="BPMNPlane_ToBe" bpmnElement="Collaboration_ToBe">
      <bpmndi:BPMNShape id="Participant_User_di" bpmnElement="Participant_User" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1500" height="360" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Start_User_di" bpmnElement="Event_Start_User">
        <dc:Bounds x="212" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="190" y="305" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OpenBrowser_di" bpmnElement="Task_OpenBrowser">
        <dc:Bounds x="290" y="240" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Login_di" bpmnElement="Task_Login">
        <dc:Bounds x="430" y="240" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_AuthSuccess_di" bpmnElement="Event_AuthSuccess">
        <dc:Bounds x="572" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="552" y="224.5" width="75" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SelectBucket_di" bpmnElement="Task_SelectBucket">
        <dc:Bounds x="650" y="240" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DragDrop_di" bpmnElement="Task_DragDrop">
        <dc:Bounds x="790" y="240" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_WaitResponse_di" bpmnElement="Gateway_WaitResponse">
        <dc:Bounds x="925" y="255" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="905" y="225" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MergeUser_di" bpmnElement="Gateway_MergeUser" isMarkerVisible="true">
        <dc:Bounds x="1455" y="255" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_End_User_di" bpmnElement="Event_End_User">
        <dc:Bounds x="1542" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1532" y="305" width="57" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_UploadError_di" bpmnElement="Event_UploadError">
        <dc:Bounds x="932" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="836.5" y="373" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_NeedShare_di" bpmnElement="Gateway_NeedShare" isMarkerVisible="true">
        <dc:Bounds x="1135" y="255" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1129" y="314.5" width="61" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_UploadSuccess_di" bpmnElement="Event_UploadSuccess">
        <dc:Bounds x="1072" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1065" y="224.5" width="50" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_End_Error_di" bpmnElement="Event_End_Error">
        <dc:Bounds x="1022" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1014" y="405" width="53" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ShareLink_di" bpmnElement="Task_ShareLink">
        <dc:Bounds x="1340" y="140" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GeneratePresigned_di" bpmnElement="Task_GeneratePresigned">
        <dc:Bounds x="1210" y="140" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_U1_di" bpmnElement="Flow_U1">
        <di:waypoint x="248" y="280" />
        <di:waypoint x="290" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_U2_di" bpmnElement="Flow_U2">
        <di:waypoint x="390" y="280" />
        <di:waypoint x="430" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_U3_di" bpmnElement="Flow_U3">
        <di:waypoint x="530" y="280" />
        <di:waypoint x="572" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_U4_di" bpmnElement="Flow_U4">
        <di:waypoint x="608" y="280" />
        <di:waypoint x="650" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_U5_di" bpmnElement="Flow_U5">
        <di:waypoint x="750" y="280" />
        <di:waypoint x="790" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_U6_di" bpmnElement="Flow_U6">
        <di:waypoint x="890" y="280" />
        <di:waypoint x="925" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_U6a_di" bpmnElement="Flow_U6a">
        <di:waypoint x="975" y="280" />
        <di:waypoint x="1072" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_U6b_di" bpmnElement="Flow_U6b">
        <di:waypoint x="950" y="305" />
        <di:waypoint x="950" y="362" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_U8_No_di" bpmnElement="Flow_U8_No">
        <di:waypoint x="1185" y="280" />
        <di:waypoint x="1455" y="280" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1313" y="262" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_U10_di" bpmnElement="Flow_U10">
        <di:waypoint x="1440" y="180" />
        <di:waypoint x="1480" y="180" />
        <di:waypoint x="1480" y="255" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_U11_di" bpmnElement="Flow_U11">
        <di:waypoint x="1505" y="280" />
        <di:waypoint x="1542" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_U7_Error_di" bpmnElement="Flow_U7_Error">
