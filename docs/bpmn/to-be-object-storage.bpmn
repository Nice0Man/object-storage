<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_ToBe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.42.0">
  <bpmn:process id="Process_ToBe_ObjectStorage" name="Процесс загрузки объекта (TO BE)" isExecutable="true">
    <bpmn:startEvent id="Event_Start" name="Необходимо загрузить файл">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_OpenBrowser" name="Открыть веб-интерфейс Object Storage">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Login" name="Ввести логин и пароль">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="Task_ValidateCredentials" name="Валидация учетных данных">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GenerateToken" name="Генерация JWT токена">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="Task_SelectBucket" name="Выбрать бакет">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DragDrop" name="Drag and Drop файла">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="Task_ValidateRequest" name="Валидация JWT и прав доступа">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Валидация пройдена?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_9_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ReturnError" name="Возврат ошибки 403">
      <bpmn:incoming>Flow_9_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Error</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CalcEtag" name="Вычисление ETag (MD5)">
      <bpmn:incoming>Flow_9_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Encryption" name="Шифрование включено?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_11_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Encrypt" name="Шифрование данных (AES-256)">
      <bpmn:incoming>Flow_11_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MergeEncrypt" name="">
      <bpmn:incoming>Flow_11_No</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SaveToStorage" name="Атомарная запись на диск">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_WriteMetaFile" name="Запись .meta файла">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Versioning" name="Версионирование?">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_16_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CreateVersion" name="Создать новую версию">
      <bpmn:incoming>Flow_16_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MergeVersion" name="">
      <bpmn:incoming>Flow_16_No</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SaveMetadata" name="Сохранение метаданных в БД">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_LogActivity" name="Логирование операции">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ReturnResult" name="Возврат успешного результата">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Share" name="Поделиться файлом?">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_22_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_GeneratePresigned" name="Сгенерировать Presigned URL">
      <bpmn:incoming>Flow_22_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="Task_ShareLink" name="Отправить ссылку коллегам">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_MergeShare" name="">
      <bpmn:incoming>Flow_22_No</bpmn:incoming>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_End" name="Операция завершена">
      <bpmn:incoming>Flow_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Task_OpenBrowser" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_OpenBrowser" targetRef="Task_Login" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Login" targetRef="Task_ValidateCredentials" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ValidateCredentials" targetRef="Task_GenerateToken" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_GenerateToken" targetRef="Task_SelectBucket" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_SelectBucket" targetRef="Task_DragDrop" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_DragDrop" targetRef="Task_ValidateRequest" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_ValidateRequest" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="Flow_9_Yes" name="Да" sourceRef="Gateway_Valid" targetRef="Task_CalcEtag" />
    <bpmn:sequenceFlow id="Flow_9_No" name="Нет" sourceRef="Gateway_Valid" targetRef="Task_ReturnError" />
    <bpmn:sequenceFlow id="Flow_Error" sourceRef="Task_ReturnError" targetRef="Event_End_Error" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_CalcEtag" targetRef="Gateway_Encryption" />
    <bpmn:sequenceFlow id="Flow_11_Yes" name="Да" sourceRef="Gateway_Encryption" targetRef="Task_Encrypt" />
    <bpmn:sequenceFlow id="Flow_11_No" name="Нет" sourceRef="Gateway_Encryption" targetRef="Gateway_MergeEncrypt" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Encrypt" targetRef="Gateway_MergeEncrypt" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_MergeEncrypt" targetRef="Task_SaveToStorage" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_SaveToStorage" targetRef="Task_WriteMetaFile" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_WriteMetaFile" targetRef="Gateway_Versioning" />
    <bpmn:sequenceFlow id="Flow_16_Yes" name="Да" sourceRef="Gateway_Versioning" targetRef="Task_CreateVersion" />
    <bpmn:sequenceFlow id="Flow_16_No" name="Нет" sourceRef="Gateway_Versioning" targetRef="Gateway_MergeVersion" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_CreateVersion" targetRef="Gateway_MergeVersion" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gateway_MergeVersion" targetRef="Task_SaveMetadata" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_SaveMetadata" targetRef="Task_LogActivity" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_LogActivity" targetRef="Task_ReturnResult" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_ReturnResult" targetRef="Gateway_Share" />
    <bpmn:sequenceFlow id="Flow_22_Yes" name="Да" sourceRef="Gateway_Share" targetRef="Task_GeneratePresigned" />
    <bpmn:sequenceFlow id="Flow_22_No" name="Нет" sourceRef="Gateway_Share" targetRef="Gateway_MergeShare" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_GeneratePresigned" targetRef="Task_ShareLink" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_ShareLink" targetRef="Gateway_MergeShare" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Gateway_MergeShare" targetRef="Event_End" />
    <bpmn:intermediateThrowEvent id="Event_End_Error" name="Загрузка отклонена">
      <bpmn:incoming>Flow_Error</bpmn:incoming>
    </bpmn:intermediateThrowEvent>
  </bpmn:process>
