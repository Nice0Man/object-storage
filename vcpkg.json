{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "object-storage-console",
  "version-string": "1.0.0",
  "description": "Object Storage Console - S3-compatible web console built with C++20 and Drogon framework",
  "homepage": "https://github.com/Nice0Man/object-storage",
  "license": "AGPL-3.0",
  "dependencies": [
    {
      "name": "drogon",
      "version>=": "1.9.3",
      "features": ["ctl", "orm"]
    },
    {
      "name": "nlohmann-json",
      "version>=": "3.11.2"
    },
    {
      "name": "jwt-cpp",
      "version>=": "0.6.0"
    },
    {
      "name": "spdlog",
      "version>=": "1.12.0",
      "features": ["std-format"]
    },
    {
      "name": "openssl",
      "version>=": "3.4.0"
    },
    {
      "name": "boost-asio",
      "version>=": "1.82.0"
    },
    {
      "name": "boost-beast",
      "version>=": "1.82.0"
    },
    {
      "name": "boost-system",
      "version>=": "1.82.0"
    },
    {
      "name": "boost-uuid",
      "version>=": "1.82.0"
    },
    {
      "name": "fmt",
      "version>=": "10.0.0"
    },
    {
      "name": "zlib",
      "version>=": "1.2.13"
    }
  ],
  "builtin-baseline": "2d6a6cf3ac9a7cc93942c3d289a2f9c661a6f4a7"
}
