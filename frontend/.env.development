# Development optimizations for faster startup
SKIP_PREFLIGHT_CHECK=true
FAST_REFRESH=true
DISABLE_ESLINT_PLUGIN=true
TSC_COMPILE_ON_ERROR=true
GENERATE_SOURCEMAP=false

# Suppress warnings
DISABLE_NEW_JSX_TRANSFORM=false

# Listen on all interfaces (WSL / LAN): http://localhost:3000 from host browser
HOST=0.0.0.0
PORT=3000

# Empty = axios uses same origin; CRA setupProxy.js forwards /api → http://localhost:9090
REACT_APP_API_URL=
